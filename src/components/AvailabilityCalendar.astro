---
import { nextMonths, type DateRange } from '../lib/calendar';

interface Props {
  bookedRanges: DateRange[];
  monthsToShow?: number;
  monthsPerPage?: number;
  locale: string;
  weekdayLabels: string[];
  legendAvailable: string;
  legendBooked: string;
  note: string;
  prevLabel: string;
  nextLabel: string;
}

const {
  bookedRanges,
  monthsToShow = 24,
  monthsPerPage = 2,
  locale,
  weekdayLabels,
  legendAvailable,
  legendBooked,
  note,
  prevLabel,
  nextLabel,
} = Astro.props;

const grids = nextMonths(monthsToShow, bookedRanges);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' });
const pageCount = Math.ceil(grids.length / monthsPerPage);
---

<div class="calendar">
  <div class="calendar__legend">
    <span class="calendar__legend-item"><i class="dot dot--free"></i>{legendAvailable}</span>
    <span class="calendar__legend-item"><i class="dot dot--booked"></i>{legendBooked}</span>
  </div>

  <div class="calendar__months" data-calendar-months data-months-per-page={monthsPerPage}>
    {
      grids.map((grid, i) => (
        <div class="calendar__month-block" data-page={Math.floor(i / monthsPerPage)}>
          <p class="calendar__month">
            {monthFormatter.format(new Date(Date.UTC(grid.year, grid.month, 1)))}
          </p>

          <div class="calendar__grid calendar__grid--labels">
            {weekdayLabels.map((d) => (
              <span>{d}</span>
            ))}
          </div>

          <div class="calendar__grid">
            {Array.from({ length: grid.leadingEmpty }).map(() => (
              <span class="calendar__cell calendar__cell--empty" />
            ))}
            {grid.cells.map((cell) => (
              <span class:list={['calendar__cell', { 'is-booked': cell.booked }]}>{cell.day}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <div class="calendar__pager">
    <button type="button" class="btn btn--outline-dark" data-calendar-prev disabled>
      {prevLabel}
    </button>
    <button type="button" class="btn btn--outline-dark" data-calendar-next disabled={pageCount <= 1}>
      {nextLabel}
    </button>
  </div>

  <p class="calendar__note">{note}</p>
</div>

<style>
  .calendar {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
    padding: 1.75rem;
    flex: 1;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .calendar__legend {
    display: flex;
    gap: 1.1rem;
    font-size: 0.82rem;
    color: #57534a;
    margin-bottom: 1.4rem;
  }

  .calendar__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot--free {
    background: var(--color-sage);
  }

  .dot--booked {
    background: var(--color-clay);
  }

  .calendar__months {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .calendar__month-block[hidden] {
    display: none;
  }

  @media (max-width: 560px) {
    .calendar__months {
      grid-template-columns: 1fr;
    }
  }

  .calendar__pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .calendar__pager .btn {
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
  }

  .calendar__pager .btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }


  .calendar__month {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-green-deep);
    margin: 0 0 0.8rem;
    text-transform: capitalize;
  }

  .calendar__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.4rem;
  }

  .calendar__grid--labels {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #8a8577;
    text-align: center;
  }

  .calendar__cell {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    background: var(--color-cream-deep);
    font-size: 0.85rem;
    color: var(--color-ink);
  }

  .calendar__cell--empty {
    background: transparent;
  }

  .calendar__cell.is-booked {
    background: var(--color-clay);
    color: #fff;
  }

  .calendar__note {
    margin: 1.5rem 0 0;
    font-size: 0.8rem;
    color: #8a8577;
    margin-top: auto;
    padding-top: 1.5rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-calendar-months]').forEach((monthsEl) => {
    const calendar = monthsEl.closest('.calendar');
    if (!calendar) return;

    const blocks = Array.from(monthsEl.querySelectorAll<HTMLElement>('.calendar__month-block'));
    const prevBtn = calendar.querySelector<HTMLButtonElement>('[data-calendar-prev]');
    const nextBtn = calendar.querySelector<HTMLButtonElement>('[data-calendar-next]');
    const pageCount = Math.max(...blocks.map((b) => Number(b.dataset.page ?? '0'))) + 1;

    let page = 0;

    function render() {
      blocks.forEach((b) => {
        b.hidden = Number(b.dataset.page ?? '0') !== page;
      });
      if (prevBtn) prevBtn.disabled = page === 0;
      if (nextBtn) nextBtn.disabled = page >= pageCount - 1;
    }

    prevBtn?.addEventListener('click', () => {
      if (page > 0) {
        page -= 1;
        render();
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (page < pageCount - 1) {
        page += 1;
        render();
      }
    });

    render();
  });
</script>
