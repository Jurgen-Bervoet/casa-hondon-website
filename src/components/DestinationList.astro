---
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';

interface Destination {
  name: string;
  distance: string;
  description: string;
  tipsLabel: string;
  tips: string;
  /** Optional per-destination photo — falls back to a placeholder when absent. */
  image?: ImageMetadata;
}

interface DestinationGroup {
  heading: string;
  items: Destination[];
}

interface Props {
  groups: DestinationGroup[];
}

const { groups } = Astro.props;
---

<div class="destination-groups">
  {
    groups.map((group) => (
      <div class="destination-group">
        <h2 class="destination-group__heading">{group.heading}</h2>
        <div class="destinations">
          {group.items.map((d, i) => (
            <article class:list={['destination', { 'destination--reverse': i % 2 === 1 }]}>
              <div class="destination__photo">
                {d.image ? (
                  <Image src={d.image} alt={d.name} class="destination__img" width={900} />
                ) : (
                  <PlaceholderImage label={d.name} fill class="destination__img" />
                )}
              </div>
              <div class="destination__text">
                <div class="destination__head">
                  <h3>{d.name}</h3>
                  <span class="destination__distance">{d.distance}</span>
                </div>
                <p>{d.description}</p>
                <p class="destination__tips">
                  <strong>{d.tipsLabel}</strong> {d.tips}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  .destination-groups {
    display: grid;
    gap: 4.5rem;
  }

  .destination-group__heading {
    margin-bottom: 2rem;
  }

  .destinations {
    display: grid;
    gap: 3.5rem;
  }

  .destination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .destination--reverse .destination__photo {
    order: 2;
  }

  .destination--reverse .destination__text {
    order: 1;
  }

  .destination__photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .destination :global(.destination__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .destination__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.8rem;
  }

  .destination__head h3 {
    margin: 0;
  }

  .destination__distance {
    flex-shrink: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-clay-deep);
    white-space: nowrap;
  }

  .destination__text p {
    color: #3a362c;
    margin-bottom: 1rem;
  }

  .destination__tips {
    margin-bottom: 0 !important;
  }

  .destination__tips strong {
    color: var(--color-green-deep);
  }

  @media (max-width: 780px) {
    .destination {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .destination--reverse .destination__photo,
    .destination--reverse .destination__text {
      order: initial;
    }
  }
</style>
