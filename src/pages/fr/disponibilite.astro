---
import Layout from '../../layouts/Layout.astro';
import AvailabilityCalendar from '../../components/AvailabilityCalendar.astro';
import BookingForm from '../../components/BookingForm.astro';
import PricingTable from '../../components/PricingTable.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import { fetchBusyRanges } from '../../lib/calendar';
import { photo } from '../../lib/images';
import { ROUTES } from '../../i18n/routes';

const bookedRanges = await fetchBusyRanges();
---

<Layout
  lang="fr"
  active="availability"
  title="Tarifs & Disponibilité — Villa Solmira"
  description="Consultez la disponibilité de Villa Solmira, les tarifs, les conditions de paiement et les conditions d'annulation."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Tarifs & Disponibilité</span>
      <h1>Planifiez votre séjour</h1>
      <p>
        Consultez notre calendrier pour voir quand la maison est disponible et choisissez la
        période qui vous convient. Il n'y a pas de jour d'arrivée fixe.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Photo : piscine et terrasse" image={photo('terras1-15.png')} />
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Tarifs</h2>
      <p class="section-intro">
        Nos tarifs dépendent de la saison. Vous trouverez ci-dessous un premier prix indicatif
        par saison — les tarifs définitifs seront ajoutés ici prochainement.
      </p>
      <PricingTable
        headers={{ season: 'Saison', period: 'Période', perWeek: 'Par semaine' }}
        rows={[
          {
            season: 'Basse saison',
            period: 'Du 15 septembre au 14 mars (hors Noël et Nouvel An)',
            perWeek: '750 €',
          },
          {
            season: 'Moyenne saison',
            period: 'Du 15 mars au 14 juin, et Noël et Nouvel An',
            perWeek: '950 €',
          },
          {
            season: 'Haute saison',
            period: 'Du 15 juin au 14 septembre',
            perWeek: '1 450 €',
          },
        ]}
      />
      <p class="fine-print">
        Remarque : il s'agit de tarifs indicatifs provisoires, basés sur des biens comparables
        dans la région. Les tarifs définitifs seront ajoutés ici dès qu'ils seront fixés.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Disponibilité</h2>
        <AvailabilityCalendar
          bookedRanges={bookedRanges}
          locale="fr-FR"
          weekdayLabels={['Lu', 'Ma', 'Me', 'Je', 'Ve', 'Sa', 'Di']}
          legendAvailable="Disponible"
          legendBooked="Réservé"
          note="Vous ne voyez pas vos dates souhaitées marquées comme réservées ? Envoyez votre demande via le formulaire."
        />
      </div>
      <div>
        <h2>Demandez votre séjour</h2>
        <BookingForm
          labels={{
            name: 'Nom',
            email: 'Adresse e-mail',
            phone: 'Téléphone',
            arrival: "Date d'arrivée",
            departure: 'Date de départ',
            guests: 'Nombre de personnes',
            message: 'Message (facultatif)',
            submit: 'Envoyer la demande',
            success: 'Merci ! Votre demande a été envoyée — nous vous recontactons rapidement.',
            error: "Une erreur s'est produite lors de l'envoi. Réessayez ou écrivez-nous directement.",
          }}
        />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>À savoir</h2>
      <ul class="practical">
        <li>L'arrivée se fait entre 16h00 et 21h00, le départ au plus tard à 11h00.</li>
        <li>Votre réservation est définitive après le paiement de 50% du montant de la location ; le solde et la caution (800 €) sont réglés un mois avant l'arrivée.</li>
        <li>L'annulation est gratuite jusqu'à 8 semaines avant le séjour. Passé ce délai, des frais d'annulation progressifs s'appliquent.</li>
      </ul>
      <p class="fine-print">
        Voici les points essentiels en bref. Pour tous les détails — dont le règlement
        intérieur, les frais d'énergie et la responsabilité — consultez nos{' '}
        <a href={ROUTES.terms.fr}>conditions générales</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .section-intro {
    max-width: 68ch;
    margin-bottom: 2rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .practical {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 60ch;
  }

  .practical li {
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .fine-print {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #57534a;
  }

  .fine-print a {
    color: var(--color-clay-deep);
    font-weight: 600;
  }
</style>
