---
import Layout from '../../layouts/Layout.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import FacilityIcons from '../../components/FacilityIcons.astro';
import BedroomCards from '../../components/BedroomCards.astro';
import BathroomFeature from '../../components/BathroomFeature.astro';
import AlternatingStory from '../../components/AlternatingStory.astro';
import CTABlock from '../../components/CTABlock.astro';
import { photo } from '../../lib/images';
import { ROUTES } from '../../i18n/routes';
---

<Layout
  lang="es"
  active="house"
  title="La Casa — Casa Lana"
  description="Descubre Casa Lana: distribución, dormitorios, baños, cocina y la piscina privada de esta casa de vacaciones en Hondón de las Nieves."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">La Casa</span>
      <h1>Espacio, comodidad y calma</h1>
      <p>
        Casa Lana es una vivienda amplia, totalmente en una planta, para un máximo de seis
        personas. La casa está en una parcela completamente vallada de 10.000 m² y ofrece
        mucha privacidad y espacio. En el interior encontrarás tres amplios dormitorios, dos
        baños, un salón, una cocina totalmente equipada y un trastero. El aire acondicionado y
        la calefacción centrales garantizan una temperatura agradable durante todo el año.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Foto: salón" image={photo('woonkamer1-4.jpg')} />
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Todo para una estancia relajada</h2>
      <FacilityIcons
        items={[
          {
            icon: 'people',
            title: 'Capacidad',
            text: 'Hasta 6 personas.',
          },
          {
            icon: 'bed',
            title: 'Dormitorios',
            text: '3 dormitorios amplios, cada uno con una cama de matrimonio de 160 cm de ancho.',
          },
          {
            icon: 'bath',
            title: 'Baños',
            text: '2 baños totalmente equipados, con secador de pelo.',
          },
          {
            icon: 'pool',
            title: 'Piscina privada',
            text: 'Piscina de 3 x 12 metros, exclusivamente para vuestro grupo.',
          },
          {
            icon: 'fence',
            title: 'Parcela propia',
            text: '10.000 m² de parcela completamente vallada.',
          },
          {
            icon: 'terrace',
            title: 'Terraza soleada',
            text: 'Zona de estar, mesa exterior y barbacoa, con vistas a la sierra.',
          },
          {
            icon: 'kitchen',
            title: 'Cocina bien equipada',
            text: 'Horno, lavavajillas, freidora de aire y cafetera Dolce Gusto Neo.',
          },
          {
            icon: 'wifi',
            title: 'Wifi gratis',
            text: 'Wifi gratuito en toda la casa.',
          },
          {
            icon: 'tv',
            title: 'TV',
            text: 'Televisión en el salón.',
          },
          {
            icon: 'heating',
            title: 'Calefacción y A/A',
            text: 'Aire acondicionado y calefacción central, complementados con una estufa de pellets.',
          },
          {
            icon: 'parking',
            title: 'Parking y garaje',
            text: 'Parking privado en la propia finca y un amplio garaje.',
          },
          {
            icon: 'pin',
            title: 'Ubicación tranquila',
            text: 'Totalmente en una planta, lejos del turismo de masas.',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Dormir</h2>
      <p class="section-intro">
        Casa Lana cuenta con tres amplios dormitorios para dos personas cada uno. Cada
        habitación tiene una cama de matrimonio de 160 cm de ancho. A vuestra llegada, las
        camas ya están hechas: vuestras vacaciones pueden empezar de inmediato.
      </p>
      <BedroomCards
        items={[
          {
            name: 'Dormitorio 1 — principal',
            photoLabel: 'Foto: dormitorio 1 (principal)',
            image: photo('master-bedroom2.jpg'),
            bed: 'Cama de matrimonio de 160 cm de ancho',
            badges: ['Baño propio (en suite)', 'Vistas y acceso directo a la piscina'],
          },
          {
            name: 'Dormitorio 2',
            photoLabel: 'Foto: dormitorio 2',
            image: photo('slaapkamer2-1.jpg'),
            bed: 'Cama de matrimonio de 160 cm de ancho',
          },
          {
            name: 'Dormitorio 3',
            photoLabel: 'Foto: dormitorio 3',
            image: photo('slaapkamer3-1.jpg'),
            bed: 'Cama de matrimonio de 160 cm de ancho',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <BathroomFeature
        title="Baños"
        leftImage={photo('badkamer1-1.jpg')}
        leftLabel="Foto: baño compartido (bañera y ducha)"
        rightImage={photo('badkamer2-2.jpg')}
        rightLabel="Foto: baño en suite (principal)"
        paragraphs={[
          'La casa tiene dos baños totalmente equipados. El dormitorio principal tiene su propio baño en suite. El segundo baño, con bañera y ducha, lo comparten los dormitorios 2 y 3.',
          'Por persona proporcionamos una toalla de baño grande y una toalla pequeña. También hay secador de pelo disponible. Los baños tienen mosquiteras.',
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <AlternatingStory
        items={[
          {
            heading: 'Una cocina donde de verdad se puede cocinar',
            imageLabel: 'Foto: cocina',
            image: photo('keuken1-2.jpg'),
            paragraphs: [
              '¿Cocinar algo elaborado, preparar algo rápido para los niños o tomar un café tranquilo en la terraza por la mañana? La cocina está totalmente equipada para una estancia cómoda.',
              'Encontraréis frigorífico, congelador pequeño, lavavajillas, horno, microondas, freidora de aire, hervidor de agua, exprimidor y una cafetera Dolce Gusto Neo. También hay platos, vasos, tazas, cubiertos, utensilios de cocina y demás menaje en abundancia.',
            ],
          },
          {
            heading: 'Confort en toda la casa',
            imageLabel: 'Foto: salón',
            image: photo('woonkamer1-3.jpg'),
            paragraphs: [
              'Casa Lana dispone de aire acondicionado y calefacción central, complementados con una estufa de pellets. Hay wifi en toda la casa y también televisión.',
              'También disponéis de lavadora, aspiradora y plancha. Para familias con bebés, proporcionamos bajo petición una cuna y una trona. Toda la casa está en una sola planta, sin escaleras en el interior.',
            ],
          },
          {
            heading: 'Vivir al aire libre',
            imageLabel: 'Foto: terraza',
            image: photo('terras1-6b.jpg'),
            paragraphs: [
              'Cuando vienes a España, sobre todo quieres vivir al aire libre. Por eso, para nosotros, el espacio exterior es al menos tan importante como la propia casa.',
              'Casa Lana está en una parcela de 10.000 m² y cuenta con una gran piscina privada de 3 por 12 metros. La piscina es exclusivamente para vuestro grupo y se mantiene cada semana, los jueves.',
              'Alrededor de la piscina hay seis tumbonas. No hay sombra natural en la piscina ni en la terraza; proporcionamos sombrillas para que podáis crear vuestro propio rincón de sombra.',
              'Hay una zona de estar para tomar algo tranquilamente y una gran mesa exterior con ocho sillas para desayunar, comer o cenar juntos con calma. La barbacoa está lista para las noches en las que os apetezca comer en casa. También hay iluminación exterior, de modo que la terraza sigue formando parte de vuestra noche después de la puesta de sol.',
            ],
          },
          {
            heading: 'Todo el espacio para vosotros',
            imageLabel: 'Foto: terreno alrededor de Casa Lana',
            image: photo('terrein1-1.jpg'),
            paragraphs: [
              'Toda la parcela está vallada. Aparcáis el coche en la propia finca y también hay un amplio garaje.',
              'Casa Lana está exenta y ofrece mucho espacio alrededor de la vivienda. Al mismo tiempo, en los alrededores viven personas con quienes mantenemos una buena relación. Calma y privacidad, sin la sensación de estar totalmente aislados del mundo.',
            ],
            listHeading: 'Para traer vosotros mismos',
            list: ['Toallas de playa', 'Opcionalmente, juguetes de piscina'],
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight" id="galeria">
    <div class="wrap">
      <h2>Galería</h2>
      <PhotoGrid
        closeLabel="Cerrar"
        prevLabel="Anterior"
        nextLabel="Siguiente"
        items={[
          { label: 'Piscina y terraza', image: photo('zwembad en terras.jpg') },
          { label: 'Terraza', image: photo('terras1-13.jpg') },
          { label: 'Mesa exterior', image: photo('buitentafel1-5.jpg') },
          { label: 'Salón', image: photo('woonkamer1-1.jpg') },
          { label: 'Cocina', image: photo('keuken1-1.jpg') },
          { label: 'Dormitorio 1', image: photo('master-bedroom.jpg') },
          { label: 'Dormitorio 2', image: photo('slaapkamer2-2.jpg') },
          { label: 'Dormitorio 3', image: photo('slaapkamer3-2.jpg') },
          { label: 'Baño 1', image: photo('badkamer1-2.jpg') },
          { label: 'Baño 2', image: photo('badkamer2-1.jpg') },
          { label: 'Zona de estar', image: photo('lounge1-1.jpg') },
          { label: 'Casa Lana por fuera', image: photo('hero.jpg') },
          { label: 'Ambiente nocturno', image: photo('IMG_6065.jpg') },
          { label: 'Entorno', image: photo('IMG_6059.jpg') },
          { label: 'Piscina de noche', image: photo('IMG_6058.jpg') },
          { label: 'Terraza al atardecer', image: photo('terras1-6b.jpg') },
        ]}
      />
    </div>
  </section>

  <CTABlock
    title="¿Te apetece alojarte aquí?"
    text="Consulta la disponibilidad de Casa Lana y envía tu solicitud."
    ctaLabel="Consultar disponibilidad"
    ctaHref={ROUTES.availability.es}
  />
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .section-intro {
    max-width: 68ch;
    margin-bottom: 2rem;
  }

</style>
