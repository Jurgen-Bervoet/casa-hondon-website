---
import { ROUTES, LANGS, LANG_LABELS, type Lang, type PageGroup } from '../i18n/routes';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  active: PageGroup;
}

const { lang, active } = Astro.props;
const t = UI[lang];

const navItems: { group: PageGroup; label: string }[] = [
  { group: 'home', label: t.nav.home },
  { group: 'house', label: t.nav.house },
  { group: 'area', label: t.nav.area },
  { group: 'availability', label: t.nav.availability },
  { group: 'contact', label: t.nav.contact },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href={ROUTES.home[lang]} class="site-header__brand">Casa Helena</a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle" aria-label="Menu">
      <span></span>
    </label>

    <nav class="site-header__nav">
      {
        navItems.map((item) => (
          <a
            href={ROUTES[item.group][lang]}
            class:list={['site-header__link', { 'is-active': item.group === active }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__langs">
      {
        LANGS.map((l) => (
          <a
            href={ROUTES[active][l]}
            class:list={['site-header__lang', { 'is-active': l === lang }]}
            aria-current={l === lang ? 'true' : undefined}
          >
            {LANG_LABELS[l]}
          </a>
        ))
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(246, 241, 226, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    flex-wrap: wrap;
  }

  .site-header__brand {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    text-decoration: none;
    color: var(--color-green-deep);
    letter-spacing: 0.01em;
  }

  .site-header__nav {
    display: flex;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .site-header__link {
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-ink);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--color-green-deep);
    border-bottom-color: var(--color-green-deep);
  }

  .site-header__langs {
    display: flex;
    gap: 0.4rem;
  }

  .site-header__lang {
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-green);
    padding: 0.25rem 0.5rem;
    border-radius: 0;
  }

  .site-header__lang.is-active {
    background: var(--color-green-deep);
    color: var(--color-cream);
  }

  .nav-toggle-input {
    display: none;
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 780px) {
    .site-header__nav {
      display: none;
      flex-basis: 100%;
      order: 3;
      flex-direction: column;
      gap: 0.9rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-line);
    }

    .nav-toggle {
      display: inline-flex;
      width: 28px;
      height: 20px;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      order: 2;
    }

    .nav-toggle span,
    .nav-toggle::before,
    .nav-toggle::after {
      content: '';
      display: block;
      height: 2px;
      background: var(--color-green-deep);
    }

    .nav-toggle-input:checked ~ .site-header__nav {
      display: flex;
    }
  }
</style>
