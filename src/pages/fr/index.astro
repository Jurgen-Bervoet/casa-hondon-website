---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Hero from '../../components/Hero.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import PhotoCollage from '../../components/PhotoCollage.astro';
import PhotoMosaic from '../../components/PhotoMosaic.astro';
import CTABlock from '../../components/CTABlock.astro';
import { photo } from '../../lib/images';
import { ROUTES } from '../../i18n/routes';
---

<Layout
  lang="fr"
  active="home"
  title="Casa Lana — Maison de vacances avec piscine privée à Hondón de las Nieves"
  description="Casa Lana est notre maison de vacances à Hondón de las Nieves : calme, espace et une piscine privée dans l'arrière-pays de la Costa Blanca, pour 6 personnes."
>
  <Hero
    title="Casa Lana"
    subtitle="Une magnifique maison entourée de montagnes espagnoles, de calme et d'espace"
    ctaLabel="Voir les disponibilités"
    ctaHref={ROUTES.availability.fr}
    imageLabel="Photo : piscine et terrasse de Casa Lana"
    image={photo('hero.jpg')}
  />

  <section class="section section--white">
    <div class="wrap intro-collage">
      <div class="intro-collage__photos">
        <PhotoMosaic
          topLeftLabel="Photo : table extérieure"
          topLeftImage={photo('buitentafel1-5.jpg')}
          bottomLeftLabel="Photo : séjour"
          bottomLeftImage={photo('woonkamer1-4.jpg')}
          rightLabel="Photo : terrasse"
          rightImage={photo('terras1-13.jpg')}
        />
      </div>
      <div class="intro-collage__text">
        <span class="eyebrow">Bienvenue dans notre coin d'Espagne</span>
        <h2>Maison pour 6 personnes</h2>
        <p class="intro__text">
          Loin de l'agitation, le temps d'un séjour. Du temps l'un pour l'autre, de longues
          matinées au bord de la piscine, des repas tranquilles sur la terrasse et le plaisir
          du silence tout autour de vous. Casa Lana est notre maison de vacances à Hondón de
          las Nieves, dans l'arrière-pays tranquille de la Costa Blanca.
        </p>
        <p class="intro__specs">
          3 chambres, 2 salles de bain · terrain de 10 000 m² · piscine privée de 3 x 12 m
        </p>
        <p class="intro__text">
          Ici, vous séjournez loin du tourisme de masse tout en ayant, étonnamment, beaucoup à
          portée de main. Le centre de Hondón de las Nieves se trouve à environ 8 minutes en
          voiture, l'aéroport d'Alicante à environ 30 minutes, et Alicante ainsi que la
          Méditerranée à environ 40 minutes.
        </p>
        <p class="intro__text">
          Vous restez aujourd'hui à la piscine ? Vous partez déguster des tapas à Alicante ?
          Vous visitez Elche, un marché local ou l'un des petits villages des environs ? Rien
          n'est obligatoire. Tout est possible.
        </p>
        <p class="intro__text intro__text--last">
          C'est l'endroit que nous cherchions nous-mêmes en Espagne. Et nous le partageons
          avec plaisir avec vous.
        </p>
        <a href={ROUTES.story.fr} class="btn btn--clay">Lisez notre histoire</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Tout pour un séjour reposant</h2>
    </div>
    <div class="feature-cards-spacing">
      <FeatureCards
        features={[
          {
            title: 'Piscine & terrasse',
            text: 'Piscine privée de 3 x 12 mètres, entretenue chaque semaine, sur un terrain de 10 000 m².',
            image: photo('zwembad en terras.jpg'),
            imageLabel: 'Photo : piscine et terrasse',
          },
          {
            title: 'Calme & nature',
            text: 'La maison est totalement isolée, dans une oasis de calme — seuls les grillons peuvent vous réveiller la nuit.',
            image: photo('IMG_6059.jpg'),
            imageLabel: 'Photo : paysage autour de Hondón de las Nieves',
          },
          {
            title: 'Hondón de las Nieves',
            text: "À environ 8 minutes en voiture se trouve le village, avec de bons restaurants et un café petit-déjeuner sympathique.",
            image: photo('IMG_6065.jpg'),
            imageLabel: 'Photo : ambiance du soir à Casa Lana',
          },
          {
            title: 'Confort & intimité',
            text: '6 personnes, 3 chambres spacieuses, 2 salles de bain et un grand garage pour votre voiture.',
            image: photo('woonkamer1-1.jpg'),
            imageLabel: 'Photo : séjour',
          },
        ]}
      />
    </div>
    <div class="wrap gallery-teaser">
      <a href={`${ROUTES.house.fr}#galerie-photo`} class="btn btn--outline-dark">Voir toutes les photos de la maison</a>
    </div>
  </section>

  <section class="section section--white decor-host">
    <Image src={photo('palmbladeren-watercolor.png')} alt="" class="decor-img" width={400} />
    <div class="wrap escape-section">
      <div class="escape-section__photos">
        <PhotoCollage
          mainLabel="Photo : terrasse"
          overlayLabel="Photo : paysage autour de Hondón de las Nieves"
          mainRatio="4 / 5"
          overlayRatio="1 / 1"
          corner="bottom-right"
          mainImage={photo('terras1-1 portrait.jpg')}
          overlayImage={photo('IMG_6059.jpg')}
        />
      </div>
      <div class="escape-section__text">
        <span class="eyebrow">La région</span>
        <h2>Loin de tout. Et pourtant jamais loin.</h2>
        <p>
          Casa Lana se trouve en plein cœur de l'arrière-pays espagnol, entourée de montagnes
          et de nature. Ici, vous vous réveillez dans le silence, et le soir, vous entendez
          surtout les grillons.
        </p>
        <p>
          Envie d'un peu plus d'animation ? Hondón de las Nieves, Aspe, Novelda et Elche sont
          tout proches. Pour une journée en ville, culture, tapas ou plage, direction Alicante.
          Santa Pola, Tabarca, Murcie, Villajoyosa et Altea sont aussi de belles destinations
          pour une excursion d'une journée. Vous combinez ainsi le calme de l'arrière-pays avec
          tout ce que la Costa Blanca a à offrir.
        </p>
        <a href={ROUTES.area.fr} class="btn btn--clay">Découvrez la région</a>
      </div>
    </div>
  </section>

  <CTABlock
    title="Planifiez votre séjour à Casa Lana"
    text="Consultez les disponibilités et envoyez votre demande — nous confirmons rapidement par e-mail."
    ctaLabel="Voir les disponibilités"
    ctaHref={ROUTES.availability.fr}
  />
</Layout>

<style>
  .feature-cards-spacing {
    margin-top: 2.5rem;
  }

  .gallery-teaser {
    text-align: center;
    margin-top: 2.5rem;
  }

  .intro-collage {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .intro__text {
    font-size: 1.05rem;
    color: #4a4638;
  }

  .intro__specs {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-green-deep);
    margin-bottom: 1.4rem;
  }

  .intro-collage__text .btn {
    margin-top: 0.5rem;
  }

  .escape-section {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .escape-section__text p {
    color: #4a4638;
    font-size: 1.05rem;
  }

  .escape-section__text .btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 780px) {
    .intro-collage {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-collage__photos {
      max-width: 420px;
      margin: 0 auto;
    }

    .escape-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .escape-section__photos {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
