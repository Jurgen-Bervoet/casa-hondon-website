---
import Layout from '../../layouts/Layout.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import InfoList from '../../components/InfoList.astro';
import BedroomCards from '../../components/BedroomCards.astro';
import BathroomFeature from '../../components/BathroomFeature.astro';
import AlternatingStory from '../../components/AlternatingStory.astro';
import CTABlock from '../../components/CTABlock.astro';
import { photo } from '../../lib/images';
import { ROUTES } from '../../i18n/routes';
---

<Layout
  lang="en"
  active="house"
  title="The House — Casa Lana"
  description="Discover Casa Lana: layout, bedrooms, bathrooms, kitchen and the private pool of this holiday home in Hondón de las Nieves."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">The House</span>
      <h1>Space, comfort and calm</h1>
      <p>
        Casa Lana is a spacious, fully single-level home for up to six people. The house
        stands on a fully fenced 10,000 m² plot and offers plenty of privacy and space.
        Inside you'll find three spacious bedrooms, two bathrooms, a living room, a fully
        equipped kitchen and a storage room. Central air conditioning and heating keep things
        comfortable all year round.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Photo: pool with mountain views" image={photo('zwembad en terras.jpg')} />
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Everything for a relaxed stay</h2>
      <InfoList
        columns={2}
        items={[
          'Sleeps 6',
          '3 spacious bedrooms',
          '2 bathrooms',
          '3 x 11 metre private pool',
          '10,000 m² own plot',
          'Fully fenced',
          'Central air conditioning and heating',
          'Pellet stove',
          'Wifi',
          'TV',
          'BBQ',
          'Private parking and garage',
          'Fully single-level',
          'Quiet location away from mass tourism',
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Sleeping</h2>
      <p class="section-intro">
        Casa Lana has three spacious bedrooms for two people each. Every bedroom has a
        160 cm-wide double bed. On arrival, the beds are already made up, so your holiday can
        start right away.
      </p>
      <BedroomCards
        items={[
          {
            name: 'Bedroom 1 — master',
            photoLabel: 'Photo: bedroom 1 (master)',
            image: photo('master-bedroom.jpg'),
            bed: '160 cm-wide double bed',
            badges: ['Own en-suite bathroom', 'Pool views and direct access'],
          },
          {
            name: 'Bedroom 2',
            photoLabel: 'Photo: bedroom 2',
            image: photo('slaapkamer2-1.jpg'),
            bed: '160 cm-wide double bed',
          },
          {
            name: 'Bedroom 3',
            photoLabel: 'Photo: bedroom 3',
            image: photo('slaapkamer3-1.jpg'),
            bed: '160 cm-wide double bed',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <BathroomFeature
        title="Bathrooms"
        leftImage={photo('badkamer2-1.jpg')}
        leftLabel="Photo: bathroom 2 (shared)"
        rightLabel="Photo: en-suite bathroom (master)"
        paragraphs={[
          "The house has two fully fitted bathrooms. The master bedroom has its own en-suite bathroom. The second bathroom, with both a bath and a shower, is shared by bedrooms 2 and 3.",
          'Per person we provide one large bath towel and one small towel. A hair dryer is also available. Both bathrooms have fly screens.',
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <AlternatingStory
        items={[
          {
            heading: 'A kitchen you can really cook in',
            imageLabel: 'Photo: kitchen',
            image: photo('keuken1-2.jpg'),
            paragraphs: [
              'Fancy cooking an elaborate meal, quickly making something for the kids, or a leisurely coffee on the terrace in the morning? The kitchen is fully equipped for a comfortable stay.',
              "You'll find a fridge, small freezer, dishwasher, oven, microwave, air fryer, kettle, juicer and a Dolce Gusto Neo coffee machine. Plates, glasses, cups, cutlery, cookware and other kitchen essentials are all plentifully provided.",
            ],
          },
          {
            heading: 'Comfort throughout the house',
            imageLabel: 'Photo: living room',
            image: photo('woonkamer1-3.jpg'),
            paragraphs: [
              "Casa Lana has central air conditioning and heating, complemented by a pellet stove. Wifi is available throughout the house, and there's a TV.",
              'A washing machine, vacuum cleaner and iron are also available. For families with a baby, we provide a cot and highchair on request. The entire house is single-level, with no stairs inside.',
            ],
          },
          {
            heading: 'Outdoor living',
            imageLabel: 'Photo: pool at night',
            image: photo('IMG_6058.jpg'),
            paragraphs: [
              "When you come to Spain, you mostly want to live outdoors. That's why the outdoor space matters to us just as much as the house itself.",
              'Casa Lana sits on a 10,000 m² plot and has a large private pool of 3 by 11 metres. The pool is exclusively for your group and is maintained weekly, on Thursdays.',
              'There are six sun loungers around the pool. There is no natural shade at the pool or terrace — we provide parasols so you can create your own shady spot.',
              "There's a seating area for a relaxed drink and a large outdoor table with eight chairs for breakfast, lunch or a long dinner together. The BBQ is ready for evenings when you fancy eating in. Outdoor lighting is also available, so the terrace stays part of your evening after sunset.",
            ],
          },
          {
            heading: 'All the space to yourselves',
            imageLabel: 'Photo: Casa Lana at sunset',
            image: photo('hero.jpg'),
            paragraphs: [
              "The entire plot is fenced. You park your car on the property itself, and there's also a spacious garage.",
              'Casa Lana stands freely and offers plenty of space around the house. At the same time, people live in the wider area with whom we have a good relationship. Peace and privacy, without feeling completely cut off from the world.',
            ],
            listHeading: 'To bring yourself',
            list: ['Beach towels', 'Optionally, pool toys'],
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Gallery</h2>
      <PhotoGrid
        items={[
          { label: 'Pool', image: photo('IMG_6053.jpg') },
          { label: 'Terrace', image: photo('IMG_6065.jpg') },
          { label: 'Living room', image: photo('woonkamer1-1.jpg') },
          { label: 'Kitchen', image: photo('keuken1-1.jpg') },
          { label: 'Bedroom 1', image: photo('master-bedroom.jpg') },
          { label: 'Bedroom 2', image: photo('slaapkamer2-1.jpg') },
          { label: 'Bedroom 3', image: photo('slaapkamer3-1.jpg') },
          { label: 'Bathroom', image: photo('badkamer2-1.jpg') },
          { label: 'Garden', image: photo('IMG_6059.jpg') },
        ]}
      />
    </div>
  </section>

  <CTABlock
    title="Fancy staying here?"
    text="Check Casa Lana's availability and send your request."
    ctaLabel="Check availability"
    ctaHref={ROUTES.availability.en}
  />
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .section-intro {
    max-width: 68ch;
    margin-bottom: 2rem;
  }

</style>
