---
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  label: string;
  image?: ImageMetadata;
  ratio?: string;
}

const { label, image, ratio = '2.6 / 1' } = Astro.props;
---

<div class="photo-band" style={{ '--band-ratio': ratio }}>
  {
    image ? (
      <Image src={image} alt={label} class="photo-band__img" width={1600} />
    ) : (
      <PlaceholderImage label={label} fill labelPosition="bottom-right" class="photo-band__img" />
    )
  }
</div>

<style>
  .photo-band {
    width: 100%;
    overflow: hidden;
    aspect-ratio: var(--band-ratio);
  }

  .photo-band :global(.photo-band__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 700px) {
    .photo-band {
      aspect-ratio: 4 / 3;
    }
  }
</style>
