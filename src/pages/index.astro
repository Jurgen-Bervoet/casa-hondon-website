---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureSlider from '../components/FeatureSlider.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import PhotoMosaic from '../components/PhotoMosaic.astro';
import CTABlock from '../components/CTABlock.astro';
import { ROUTES } from '../i18n/routes';
---

<Layout
  lang="nl"
  active="home"
  title="Casa Lana — Vakantiehuis met privézwembad in Hondón de las Nieves"
  description="Casa Lana is ons vakantiehuis in Hondón de las Nieves: rust, ruimte en een privézwembad in het binnenland van de Costa Blanca, plaats voor 6 personen."
>
  <Hero
    title="Casa Lana"
    subtitle="Een prachtig huis omgeven door Spaanse bergen, rust en ruimte"
    ctaLabel="Bekijk beschikbaarheid"
    ctaHref={ROUTES.availability.nl}
    imageLabel="Foto: zwembad en terras van Casa Lana"
    image="/hero.jpg"
  />

  <section class="section section--white">
    <div class="wrap intro-collage decor-host">
      <img src="/palmbladeren-watercolor.webp" alt="" class="decor-img" />
      <div class="intro-collage__photos">
        <PhotoMosaic
          topLeftLabel="Foto: zwembad en terras"
          topLeftImage="/zwembad%20en%20terras.jpg"
          bottomLeftLabel="Foto: keuken"
          bottomLeftImage="/keuken1-1.jpg"
          rightLabel="Foto: badkamer"
          rightImage="/badkamer2-1.jpg"
        />
      </div>
      <div class="intro-collage__text">
        <span class="eyebrow">Welkom in ons stukje Spanje</span>
        <h2>Huis voor 6 personen</h2>
        <p class="intro__text">
          Even weg van de drukte. Tijd voor elkaar, voor lange ochtenden aan het zwembad,
          uitgebreid tafelen op het terras en genieten van de stilte rondom je. Casa Lana is
          ons vakantiehuis in Hondón de las Nieves, in het rustige binnenland van de Costa
          Blanca.
        </p>
        <p class="intro__specs">
          3 slaapkamers, 2 badkamers · 10.000 m² terrein · privézwembad 3 x 11 m
        </p>
        <p class="intro__text">
          Hier verblijf je weg van het massatoerisme en ligt er tegelijk verrassend veel binnen
          bereik. Het centrum van Hondón de las Nieves ligt op ongeveer 8 minuten rijden,
          Alicante Airport op ongeveer 30 minuten en Alicante en de Middellandse Zee bereik je
          in ongeveer 40 minuten.
        </p>
        <p class="intro__text">
          Blijf je vandaag gewoon aan het zwembad? Trek je eropuit voor tapas in Alicante?
          Bezoek je Elche, een lokale markt of een van de kleine dorpjes in de omgeving?
          Niets moet. Alles kan.
        </p>
        <p class="intro__text intro__text--last">
          Dit is de plek die wij zelf zochten in Spanje. En die delen we graag met jullie. <a
            href={ROUTES.story.nl}>Lees ons verhaal →</a
          >
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Alles voor een ontspannen verblijf</h2>
      <FeatureSlider
        prevLabel="Vorige"
        nextLabel="Volgende"
        features={[
          {
            title: 'Zwembad & terras',
            text: 'Privézwembad van 3 x 11 meter, wekelijks onderhouden, op een terrein van 10.000 m².',
            image: '/zwembad%20en%20terras.jpg',
            imageLabel: 'Foto: zwembad en terras',
          },
          {
            title: 'Rust & natuur',
            text: "Het huis staat helemaal alleen, in een oase van rust — enkel de krekels maken je 's nachts wakker.",
            image: '/IMG_6059.jpg',
            imageLabel: 'Foto: landschap rond Hondón de las Nieves',
          },
          {
            title: 'Hondón de las Nieves',
            text: 'Op ongeveer 8 minuten rijden vind je het dorp, met goede restaurants en een gezellig ontbijtcafé.',
            image: '/IMG_6065.jpg',
            imageLabel: 'Foto: avondsfeer bij Casa Lana',
          },
          {
            title: 'Comfort & privacy',
            text: '6 personen, 3 ruime slaapkamers, 2 badkamers en een grote garage waar je wagen binnen kan.',
            image: '/woonkamer1-1.jpg',
            imageLabel: 'Foto: woonkamer',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap escape-section">
      <div class="escape-section__photos">
        <PhotoCollage
          mainLabel="Foto: landschap rond Hondón de las Nieves"
          overlayLabel="Foto: zwembad en terras"
          mainRatio="4 / 5"
          overlayRatio="1 / 1"
          corner="bottom-right"
          mainImage="/IMG_6059.jpg"
          overlayImage="/zwembad%20en%20terras.jpg"
        />
      </div>
      <div class="escape-section__text">
        <span class="eyebrow">De omgeving</span>
        <h2>Even weg van alles. En toch nooit ver weg.</h2>
        <p>
          Casa Lana ligt midden in het Spaanse binnenland, omgeven door bergen en natuur. Hier
          word je wakker met stilte rondom je en hoor je 's avonds vooral de krekels.
        </p>
        <p>
          Zin in wat meer leven? Hondón de las Nieves, Aspe, Novelda en Elche liggen dichtbij.
          Voor een dagje stad, cultuur, tapas of strand rijd je richting Alicante. Ook Santa
          Pola, Tabarca, Murcia, Villajoyosa en Altea zijn mooie bestemmingen voor een
          daguitstap. Zo combineer je de rust van het binnenland met alles wat de Costa Blanca
          te bieden heeft.
        </p>
        <a href={ROUTES.area.nl} class="btn btn--clay">Bekijk de omgeving</a>
      </div>
    </div>
  </section>

  <CTABlock
    title="Plan je verblijf in Casa Lana"
    text="Bekijk de beschikbaarheid en stuur een aanvraag — we bevestigen snel per e-mail."
    ctaLabel="Bekijk beschikbaarheid"
    ctaHref={ROUTES.availability.nl}
  />
</Layout>

<style>
  .intro-collage {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .intro__text {
    font-size: 1.05rem;
    color: #4a4638;
  }

  .intro__specs {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-green-deep);
    margin-bottom: 1.4rem;
  }

  .intro__text--last a {
    color: var(--color-clay-deep);
    font-weight: 600;
  }

  .escape-section {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .escape-section__text p {
    color: #4a4638;
    font-size: 1.05rem;
  }

  .escape-section__text .btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 780px) {
    .intro-collage {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-collage__photos {
      max-width: 420px;
      margin: 0 auto;
    }

    .escape-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .escape-section__photos {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
