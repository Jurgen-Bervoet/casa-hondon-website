---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  text: string;
  ctaLabel: string;
  ctaHref: string;
  image: ImageMetadata;
  imageLabel: string;
}

const { title, text, ctaLabel, ctaHref, image, imageLabel } = Astro.props;
---

<section class="section section--white photo-cta">
  <div class="wrap photo-cta__inner">
    <Image src={image} alt={imageLabel} class="photo-cta__img" width={1400} />
    <div class="photo-cta__text">
      <h2>{title}</h2>
      <p>{text}</p>
      <a href={ctaHref} class="btn btn--clay">{ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .photo-cta__inner {
    text-align: center;
  }

  .photo-cta__img {
    width: 100%;
    max-width: 960px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .photo-cta__text {
    max-width: 48ch;
    margin: 2rem auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .photo-cta__text p {
    margin: 0;
    color: #4a4638;
  }
</style>
