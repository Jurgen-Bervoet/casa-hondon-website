---
import Layout from '../../layouts/Layout.astro';
import AvailabilityCalendar from '../../components/AvailabilityCalendar.astro';
import BookingForm from '../../components/BookingForm.astro';
import PricingTable from '../../components/PricingTable.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import { fetchBusyRanges } from '../../lib/calendar';
import { photo } from '../../lib/images';
import { ROUTES } from '../../i18n/routes';

const bookedRanges = await fetchBusyRanges();
---

<Layout
  lang="es"
  active="availability"
  title="Precios y Disponibilidad — Villa Solmira"
  description="Consulta la disponibilidad de Villa Solmira, los precios, las condiciones de pago y las condiciones de cancelación."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Precios y Disponibilidad</span>
      <h1>Planifica tu estancia</h1>
      <p>
        Consulta en nuestro calendario cuándo está disponible la casa y elige el periodo que
        mejor os convenga. No hay un día de llegada fijo.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Foto: piscina y terraza" image={photo('terras1-15.png')} />
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Precios</h2>
      <p class="section-intro">
        Nuestros precios dependen de la temporada. A continuación encontrarás el precio por
        semana para cada temporada.
      </p>
      <PricingTable
        headers={{ season: 'Temporada', period: 'Periodo', perWeek: 'Por semana' }}
        rows={[
          {
            season: 'Temporada baja',
            period: 'Del 15 de septiembre al 14 de marzo (excepto Navidad y Año Nuevo)',
            perWeek: '750 €',
          },
          {
            season: 'Temporada media',
            period: 'Del 15 de marzo al 14 de junio, y Navidad y Año Nuevo',
            perWeek: '950 €',
          },
          {
            season: 'Temporada alta',
            period: 'Del 15 de junio al 14 de septiembre',
            perWeek: '1.450 €',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Disponibilidad</h2>
        <AvailabilityCalendar
          bookedRanges={bookedRanges}
          locale="es-ES"
          weekdayLabels={['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá', 'Do']}
          legendAvailable="Disponible"
          legendBooked="Ocupado"
          prevLabel="Anterior"
          nextLabel="Siguiente"
          note="¿No ves disponible la fecha que buscas? Envíanos tu solicitud igualmente a través del formulario."
        />
      </div>
      <div>
        <h2>Solicita tu estancia</h2>
        <BookingForm
          labels={{
            name: 'Nombre',
            email: 'Correo electrónico',
            phone: 'Teléfono',
            arrival: 'Fecha de llegada',
            departure: 'Fecha de salida',
            guests: 'Número de huéspedes',
            message: 'Mensaje (opcional)',
            submit: 'Enviar solicitud',
            success: 'Gracias! Tu solicitud ha sido enviada — te contactaremos pronto.',
            error: 'Algo salió mal al enviar. Inténtalo de nuevo o escríbenos directamente.',
          }}
        />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Lo más importante</h2>
      <ul class="practical">
        <li>El check-in es entre las 16:00 y las 21:00; el check-out, como máximo a las 11:00.</li>
        <li>Tu reserva es definitiva tras el pago del 50% del alquiler; el resto y la fianza (800 €) se pagan un mes antes de la llegada.</li>
        <li>La limpieza final (150 €) es obligatoria y se cobra aparte.</li>
        <li>Puedes cancelar gratis hasta 8 semanas antes. A partir de ahí se aplican costes de cancelación crecientes.</li>
        <li>La ropa de cama y las toallas están incluidas; trae tus propias toallas de playa.</li>
      </ul>
      <p class="fine-print">
        Estos son los puntos más importantes en resumen. Todos los detalles — incluidas las
        normas de la casa, los costes de energía y la responsabilidad — los encontrarás en
        nuestras <a href={ROUTES.terms.es}>condiciones generales</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .section-intro {
    max-width: 68ch;
    margin-bottom: 2rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  .two-col > div {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .practical {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 60ch;
  }

  .practical li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .practical li:first-child {
    padding-top: 0;
  }

  .practical li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .fine-print {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #57534a;
  }

  .fine-print a {
    color: var(--color-clay-deep);
    font-weight: 600;
  }
</style>
