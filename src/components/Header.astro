---
import { ROUTES, LANGS, LANG_LABELS, type Lang, type PageGroup } from '../i18n/routes';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  active: PageGroup;
}

const { lang, active } = Astro.props;
const t = UI[lang];

const navItems: { group: PageGroup; label: string }[] = [
  { group: 'home', label: t.nav.home },
  { group: 'house', label: t.nav.house },
  { group: 'area', label: t.nav.area },
  { group: 'story', label: t.nav.story },
  { group: 'availability', label: t.nav.availability },
  { group: 'faq', label: t.nav.faq },
  { group: 'contact', label: t.nav.contact },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href={ROUTES.home[lang]} class="site-header__brand">Villa Solmira</a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle" aria-label="Menu">
      <span></span>
    </label>

    <nav class="site-header__nav">
      {
        navItems.map((item) => (
          <a
            href={ROUTES[item.group][lang]}
            class:list={['site-header__link', { 'is-active': item.group === active }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="lang-switcher">
      <summary class="lang-switcher__current">
        {LANG_LABELS[lang]}
        <svg class="lang-switcher__chevron" width="9" height="6" viewBox="0 0 9 6" aria-hidden="true">
          <path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <div class="lang-switcher__menu">
        {
          LANGS.filter((l) => l !== lang).map((l) => (
            <a
              href={ROUTES[active][l]}
              class="lang-switcher__option"
              onclick="document.cookie='lang-chosen=1;path=/;max-age=31536000'"
            >
              {LANG_LABELS[l]}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(246, 241, 226, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    flex-wrap: wrap;
  }

  .site-header__brand {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    text-decoration: none;
    color: var(--color-clay-deep);
    letter-spacing: 0.01em;
  }

  .site-header__nav {
    display: flex;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .site-header__link {
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
  }

  .site-header__link:hover {
    color: var(--color-green-deep);
  }

  .site-header__link.is-active {
    color: var(--color-clay-deep);
  }

  .lang-switcher {
    position: relative;
  }

  .lang-switcher__current {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-green-deep);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-line);
    user-select: none;
  }

  .lang-switcher__current::-webkit-details-marker {
    display: none;
  }

  .lang-switcher__chevron {
    color: var(--color-green);
    transition: transform 0.15s ease;
  }

  .lang-switcher[open] .lang-switcher__chevron {
    transform: rotate(180deg);
  }

  .lang-switcher__menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    min-width: 100%;
    background: #fff;
    border: 1px solid var(--color-line);
    box-shadow: 0 8px 20px rgba(20, 30, 20, 0.08);
  }

  .lang-switcher__option {
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
  }

  .lang-switcher__option:hover {
    background: var(--color-cream-deep);
    color: var(--color-green-deep);
  }

  .nav-toggle-input {
    display: none;
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 780px) {
    .site-header__nav {
      display: none;
      flex-basis: 100%;
      order: 3;
      flex-direction: column;
      gap: 0.9rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-line);
    }

    .nav-toggle {
      display: inline-flex;
      width: 28px;
      height: 20px;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      order: 2;
    }

    .nav-toggle span,
    .nav-toggle::before,
    .nav-toggle::after {
      content: '';
      display: block;
      height: 2px;
      background: var(--color-green-deep);
    }

    .nav-toggle-input:checked ~ .site-header__nav {
      display: flex;
    }
  }
</style>

<script>
  // Close the language dropdown on outside click (native <details> only
  // closes on a second click of its own summary).
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.lang-switcher[open]').forEach((el) => {
      if (!el.contains(e.target as Node)) el.open = false;
    });
  });
</script>
