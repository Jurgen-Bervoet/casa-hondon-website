---
import Layout from '../../layouts/Layout.astro';
import AvailabilityCalendar from '../../components/AvailabilityCalendar.astro';
import BookingForm from '../../components/BookingForm.astro';
---

<Layout
  lang="es"
  active="availability"
  title="Disponibilidad y Reservas — Casa Helena"
  description="Consulta la disponibilidad de Casa Helena y envía tu solicitud de reserva."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Disponibilidad y Reservas</span>
      <h1>Planifica tu estancia</h1>
      <p>
        Consulta a continuación la disponibilidad de Casa Helena y envía tu solicitud
        para las fechas deseadas. Confirmaremos tu solicitud por correo electrónico lo
        antes posible.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Disponibilidad</h2>
        <AvailabilityCalendar
          monthLabel="Mes de ejemplo (demo)"
          weekdayLabels={['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá', 'Do']}
          legendAvailable="Disponible"
          legendBooked="Ocupado"
          note="Estos son datos de ejemplo. La disponibilidad real se añadirá próximamente."
        />
      </div>
      <div>
        <h2>Formulario de solicitud</h2>
        <BookingForm
          labels={{
            name: 'Nombre',
            email: 'Correo electrónico',
            phone: 'Teléfono',
            arrival: 'Fecha de llegada',
            departure: 'Fecha de salida',
            guests: 'Número de huéspedes',
            message: 'Mensaje (opcional)',
            submit: 'Enviar solicitud',
          }}
        />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Información práctica</h2>
      <ul class="practical">
        <li><strong>Entrada</strong> — entre las 13:00 y las 20:00</li>
        <li><strong>Salida</strong> — antes de las 11:00</li>
        <li><strong>Estancia mínima</strong> — por confirmar</li>
        <li><strong>Mascotas</strong> — por confirmar</li>
        <li><strong>Fumar</strong> — no permitido en el interior</li>
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Precios y fianza</h2>
        <ul class="practical">
          <li>Tu reserva es definitiva tras un primer pago del 25% del importe total del alquiler.</li>
          <li>El resto del importe se paga 6 semanas antes de la llegada.</li>
          <li>Una fianza de 1.000 € se paga como máximo 1 semana antes del inicio de la estancia.</li>
          <li>Los costes de energía están incluidos hasta un consumo estándar (orientativamente 8 €/día de electricidad y 5 €/día de agua); el consumo superior se descuenta de la fianza.</li>
          <li>Gastos de limpieza: 160 €, obligatorios por reserva.</li>
        </ul>
      </div>
      <div>
        <h2>Condiciones de cancelación</h2>
        <ul class="practical">
          <li>Cancelación a partir de 6 semanas antes del inicio: 25% del precio del alquiler</li>
          <li>Cancelación a partir de 4 semanas antes del inicio: 50% del precio del alquiler</li>
          <li>Cancelación a partir de 2 semanas antes del inicio: 100% del precio del alquiler</li>
        </ul>
        <p class="fine-print">El arrendador no se hace responsable de accidentes o robos.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .practical {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 60ch;
  }

  .practical li {
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .fine-print {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #57534a;
  }
</style>
