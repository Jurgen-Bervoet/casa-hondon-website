---
import { ROUTES, type Lang } from '../i18n/routes';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div>
        <p class="site-footer__brand">Casa Lana</p>
        <p class="site-footer__tagline">{t.footer.tagline}</p>
      </div>

      <nav class="site-footer__nav">
        <a href={ROUTES.home[lang]}>{t.nav.home}</a>
        <a href={ROUTES.house[lang]}>{t.nav.house}</a>
        <a href={ROUTES.area[lang]}>{t.nav.area}</a>
        <a href={ROUTES.story[lang]}>{t.nav.story}</a>
        <a href={ROUTES.availability[lang]}>{t.nav.availability}</a>
        <a href={ROUTES.faq[lang]}>{t.nav.faq}</a>
        <a href={ROUTES.contact[lang]}>{t.nav.contact}</a>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">© {year} Casa Lana — {t.footer.rights}</p>
      <nav class="site-footer__legal">
        <a href={ROUTES.terms[lang]}>{t.footer.terms}</a>
        <a href={ROUTES.privacy[lang]}>{t.footer.privacy}</a>
        <a href="#" data-open-cookie-settings>{t.cookies.customize}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-green-deep);
    color: var(--color-cream);
    padding: 3rem 0 2rem;
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 5rem;
  }

  .site-footer__brand {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
  }

  .site-footer__tagline {
    max-width: 32ch;
    font-size: 0.9rem;
    opacity: 0.85;
    margin: 0;
  }

  .site-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .site-footer__nav a {
    text-decoration: none;
    color: var(--color-cream);
    opacity: 0.85;
  }

  .site-footer__nav a:hover {
    opacity: 1;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .site-footer__copy {
    font-size: 0.8rem;
    opacity: 0.65;
    margin: 0;
  }

  .site-footer__legal {
    display: flex;
    gap: 1rem;
    font-size: 0.78rem;
  }

  .site-footer__legal a {
    text-decoration: none;
    color: var(--color-cream);
    opacity: 0.65;
  }

  .site-footer__legal a:hover {
    opacity: 1;
  }

  @media (max-width: 560px) {
    .site-footer__top {
      gap: 2rem;
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
