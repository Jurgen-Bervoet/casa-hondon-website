---
interface Labels {
  name: string;
  email: string;
  phone: string;
  arrival: string;
  departure: string;
  guests: string;
  message: string;
  submit: string;
  success: string;
  error: string;
}

interface Props {
  labels: Labels;
}

const { labels } = Astro.props;
---

<form
  name="booking"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="booking-form"
  data-form
>
  <input type="hidden" name="form-name" value="booking" />
  <p class="hp-field">
    <label>Don't fill this out: <input name="bot-field" /></label>
  </p>

  <div class="field-row">
    <div class="field">
      <label for="name">{labels.name}</label>
      <input type="text" id="name" name="name" required />
    </div>
    <div class="field">
      <label for="email">{labels.email}</label>
      <input type="email" id="email" name="email" required />
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="phone">{labels.phone}</label>
      <input type="tel" id="phone" name="phone" />
    </div>
    <div class="field">
      <label for="guests">{labels.guests}</label>
      <input type="number" id="guests" name="guests" min="1" />
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="arrival">{labels.arrival}</label>
      <input type="date" id="arrival" name="arrival" required />
    </div>
    <div class="field">
      <label for="departure">{labels.departure}</label>
      <input type="date" id="departure" name="departure" required />
    </div>
  </div>

  <div class="field">
    <label for="message">{labels.message}</label>
    <textarea id="message" name="message" rows="4"></textarea>
  </div>

  <button type="submit" class="btn btn--clay" data-submit-btn>{labels.submit}</button>

  <p class="form-message form-message--success" data-success hidden>{labels.success}</p>
  <p class="form-message form-message--error" data-error hidden>{labels.error}</p>
</form>

<style>
  .booking-form {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
    padding: 1.75rem;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
  }

  .form-message {
    margin: 1rem 0 0;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
  }

  .form-message--success {
    background: #e7f0e0;
    color: var(--color-green-deep);
  }

  .form-message--error {
    background: #fbe6e0;
    color: #a33b1e;
  }
</style>

<script>
  function encode(data: Record<string, string>) {
    return Object.keys(data)
      .map((key) => encodeURIComponent(key) + '=' + encodeURIComponent(data[key]))
      .join('&');
  }

  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries()) as Record<string, string>;
      const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit-btn]');
      const successEl = form.querySelector<HTMLElement>('[data-success]');
      const errorEl = form.querySelector<HTMLElement>('[data-error]');

      if (submitBtn) submitBtn.disabled = true;
      errorEl?.setAttribute('hidden', '');

      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: encode(data),
      })
        .then(() => {
          form.reset();
          successEl?.removeAttribute('hidden');
          if (submitBtn) submitBtn.style.display = 'none';
        })
        .catch(() => {
          errorEl?.removeAttribute('hidden');
          if (submitBtn) submitBtn.disabled = false;
        });
    });
  });
</script>
