---
import Layout from '../../layouts/Layout.astro';
import AvailabilityCalendar from '../../components/AvailabilityCalendar.astro';
import BookingForm from '../../components/BookingForm.astro';
---

<Layout
  lang="en"
  active="availability"
  title="Pricing & Availability — Casa Lana"
  description="Check the availability of Casa Lana, pricing, payment terms and cancellation policy."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Pricing & Availability</span>
      <h1>Plan your stay</h1>
      <p>
        Check our calendar to see when the house is available and choose the period that
        suits you. There is no fixed arrival day.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Availability</h2>
        <AvailabilityCalendar
          monthLabel="Example month (demo)"
          weekdayLabels={['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su']}
          legendAvailable="Available"
          legendBooked="Booked"
          note="This is example data. Real availability will be added here soon."
        />
      </div>
      <div>
        <h2>Request your stay</h2>
        <BookingForm
          labels={{
            name: 'Name',
            email: 'Email address',
            phone: 'Phone number',
            arrival: 'Arrival date',
            departure: 'Departure date',
            guests: 'Number of guests',
            message: 'Message (optional)',
            submit: 'Send request',
          }}
        />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Arrival and departure</h2>
      <ul class="practical">
        <li>Check-in is between 16:00 and 21:00. A €25 fee applies for arrivals after 21:00.</li>
        <li>On the day of departure, we ask you to vacate the house by 11:00 at the latest.</li>
        <li>A keyholder will greet you in person on arrival and give you the necessary information about the house.</li>
        <li><strong>Minimum stay</strong> — to be confirmed</li>
        <li><strong>Pets</strong> — we'd rather not host pets, feel free to contact us with specific questions</li>
        <li><strong>Smoking</strong> — not allowed indoors</li>
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Payment</h2>
        <ul class="practical">
          <li>Your booking is confirmed after payment of 50% of the total rental sum.</li>
          <li>The remaining amount is due no later than one month before arrival.</li>
          <li>The security deposit is €800, also due one month before arrival. After departure the house is checked; if everything is in order, the deposit is refunded within one week.</li>
          <li>The mandatory final cleaning fee is €150 per stay.</li>
        </ul>
        <h2 class="mt">Energy</h2>
        <ul class="practical">
          <li>Energy costs are included based on a standard usage of €8 electricity per day and €5 water per day. Usage above this standard is deducted from the security deposit.</li>
        </ul>
        <p class="fine-print">
          Note: this arrangement will be confirmed once it's settled how usage is measured and billed.
        </p>
      </div>
      <div>
        <h2>Cancellation policy</h2>
        <ul class="practical">
          <li>Cancelling 8 weeks before the start of the rental period: 0% of the rental price.</li>
          <li>Cancelling 6 weeks before the start of the rental period: 25% of the rental price.</li>
          <li>Cancelling 2 weeks before the start of the rental period: 100% of the rental price.</li>
        </ul>
        <p class="fine-print">
          Note: the policy for cancellations between 6 and 2 weeks before the start still needs to be defined.
        </p>
        <p class="fine-print">The owner is not responsible for accidents or theft.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .practical {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 60ch;
  }

  .practical li {
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .mt {
    margin-top: 2rem;
  }

  .fine-print {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #57534a;
  }
</style>
