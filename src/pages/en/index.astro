---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Hero from '../../components/Hero.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import PhotoCollage from '../../components/PhotoCollage.astro';
import PhotoMosaic from '../../components/PhotoMosaic.astro';
import CTABlock from '../../components/CTABlock.astro';
import { photo } from '../../lib/images';
import { ROUTES } from '../../i18n/routes';
---

<Layout
  lang="en"
  active="home"
  title="Casa Lana — Holiday home with private pool in Hondón de las Nieves"
  description="Casa Lana is our holiday home in Hondón de las Nieves: peace, space and a private pool inland from the Costa Blanca, sleeps 6."
>
  <Hero
    title="Casa Lana"
    subtitle="A beautiful house surrounded by Spanish mountains, peace and space"
    ctaLabel="Check availability"
    ctaHref={ROUTES.availability.en}
    imageLabel="Photo: pool and terrace at Casa Lana"
    image={photo('hero.jpg')}
  />

  <section class="section section--white">
    <div class="wrap intro-collage">
      <div class="intro-collage__photos">
        <PhotoMosaic
          topLeftLabel="Photo: outdoor dining table"
          topLeftImage={photo('buitentafel1-5.jpg')}
          bottomLeftLabel="Photo: living room"
          bottomLeftImage={photo('woonkamer1-4.jpg')}
          rightLabel="Photo: terrace"
          rightImage={photo('terras1-13.jpg')}
        />
      </div>
      <div class="intro-collage__text">
        <span class="eyebrow">Welcome to our little corner of Spain</span>
        <h2>House for 6 guests</h2>
        <p class="intro__text">
          Away from it all, for a while. Time for each other, for long mornings by the pool,
          leisurely meals on the terrace and enjoying the quiet around you. Casa Lana is our
          holiday home in Hondón de las Nieves, in the quiet inland of the Costa Blanca.
        </p>
        <p class="intro__specs">
          3 bedrooms, 2 bathrooms · 10,000 m² plot · 3 x 12 m private pool
        </p>
        <p class="intro__text">
          Here you stay away from mass tourism while surprisingly much is still within reach.
          The centre of Hondón de las Nieves is about an 8-minute drive away, Alicante Airport
          about 30 minutes, and Alicante and the Mediterranean about 40 minutes.
        </p>
        <p class="intro__text">
          Staying by the pool all day today? Heading out for tapas in Alicante? Visiting
          Elche, a local market or one of the small villages nearby? Nothing has to happen.
          Anything can.
        </p>
        <p class="intro__text intro__text--last">
          This is the place we ourselves were looking for in Spain. And we're happy to share
          it with you.
        </p>
        <a href={ROUTES.story.en} class="btn btn--clay">Read our story</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Everything for a relaxed stay</h2>
    </div>
    <div class="feature-cards-spacing">
      <FeatureCards
        features={[
          {
            title: 'Pool & terrace',
            text: 'A 3 x 12 metre private pool, maintained weekly, on a 10,000 m² plot.',
            image: photo('zwembad en terras.jpg'),
            imageLabel: 'Photo: pool and terrace',
          },
          {
            title: 'Peace & nature',
            text: 'The house stands completely on its own, in an oasis of calm — only the crickets might wake you at night.',
            image: photo('IMG_6059.jpg'),
            imageLabel: 'Photo: landscape around Hondón de las Nieves',
          },
          {
            title: 'Hondón de las Nieves',
            text: 'About an 8-minute drive to the village, with good restaurants and a cosy breakfast café.',
            image: photo('IMG_6065.jpg'),
            imageLabel: 'Photo: evening atmosphere at Casa Lana',
          },
          {
            title: 'Comfort & privacy',
            text: 'Sleeps 6, with 3 spacious bedrooms, 2 bathrooms and a large garage that fits your car.',
            image: photo('woonkamer1-1.jpg'),
            imageLabel: 'Photo: living room',
          },
        ]}
      />
    </div>
    <div class="wrap gallery-teaser">
      <a href={`${ROUTES.house.en}#gallery`} class="btn btn--outline-dark">See all photos of the house</a>
    </div>
  </section>

  <section class="section section--white decor-host">
    <Image src={photo('palmbladeren-watercolor.png')} alt="" class="decor-img" width={400} />
    <div class="wrap escape-section">
      <div class="escape-section__photos">
        <PhotoCollage
          mainLabel="Photo: terrace"
          overlayLabel="Photo: landscape around Hondón de las Nieves"
          mainRatio="4 / 5"
          overlayRatio="1 / 1"
          corner="bottom-right"
          mainImage={photo('terras1-1 portrait.jpg')}
          overlayImage={photo('IMG_6059.jpg')}
        />
      </div>
      <div class="escape-section__text">
        <span class="eyebrow">The area</span>
        <h2>Away from it all. Yet never far away.</h2>
        <p>
          Casa Lana sits right in the Spanish inland, surrounded by mountains and nature. Here
          you wake up to quiet around you, and at night you'll mostly hear the crickets.
        </p>
        <p>
          Fancy a bit more life? Hondón de las Nieves, Aspe, Novelda and Elche are all nearby.
          For a day of city life, culture, tapas or the beach, you head towards Alicante. Santa
          Pola, Tabarca, Murcia, Villajoyosa and Altea are also lovely day-trip destinations.
          That way you combine the calm of the inland with everything the Costa Blanca has to
          offer.
        </p>
        <a href={ROUTES.area.en} class="btn btn--clay">Explore the area</a>
      </div>
    </div>
  </section>

  <CTABlock
    title="Plan your stay at Casa Lana"
    text="Check availability and send a request — we confirm quickly by email."
    ctaLabel="Check availability"
    ctaHref={ROUTES.availability.en}
  />
</Layout>

<style>
  .feature-cards-spacing {
    margin-top: 2.5rem;
  }

  .gallery-teaser {
    text-align: center;
    margin-top: 2.5rem;
  }

  .intro-collage {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .intro__text {
    font-size: 1.05rem;
    color: #4a4638;
  }

  .intro__specs {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-green-deep);
    margin-bottom: 1.4rem;
  }

  .intro-collage__text .btn {
    margin-top: 0.5rem;
  }

  .escape-section {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .escape-section__text p {
    color: #4a4638;
    font-size: 1.05rem;
  }

  .escape-section__text .btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 780px) {
    .intro-collage {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-collage__photos {
      max-width: 420px;
      margin: 0 auto;
    }

    .escape-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .escape-section__photos {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
