---
type IconKey =
  | 'bed'
  | 'bath'
  | 'pool'
  | 'wifi'
  | 'terrace'
  | 'kitchen'
  | 'people'
  | 'fence'
  | 'tv'
  | 'heating'
  | 'parking'
  | 'pin';

interface Facility {
  icon: IconKey;
  title: string;
  text: string;
}

interface Props {
  items: Facility[];
}

const { items } = Astro.props;
---

<div class="facility-icons">
  {
    items.map((f) => (
      <div class="facility-icons__item">
        <span class="facility-icons__icon">
          {f.icon === 'bed' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 38V20a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v3" />
              <path d="M6 38v-6h36v6" />
              <path d="M42 38V26a3 3 0 0 0-3-3H20v3" />
              <path d="M6 44v-6M42 44v-6" />
            </svg>
          )}
          {f.icon === 'bath' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 24h36v4a10 10 0 0 1-10 10H16A10 10 0 0 1 6 28v-4Z" />
              <path d="M10 24v-3a3 3 0 0 1 3-3" />
              <path d="M6 38v4M42 38v4" />
              <path d="M34 6c-2 2-2 4 0 6s2 4 0 6" />
            </svg>
          )}
          {f.icon === 'pool' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="6" y="10" width="36" height="22" rx="2" />
              <path d="M6 38c3-2 6-2 9 0s6 2 9 0 6-2 9 0 6 2 9 0" />
            </svg>
          )}
          {f.icon === 'wifi' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 22a20 20 0 0 1 28 0" />
              <path d="M16 28a12 12 0 0 1 16 0" />
              <path d="M22 34a4 4 0 0 1 4 0" />
              <circle cx="24" cy="39" r="1.5" fill="currentColor" stroke="none" />
            </svg>
          )}
          {f.icon === 'terrace' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M24 6v6" />
              <path d="M8 16c2-6 8-10 16-10s14 4 16 10Z" />
              <path d="M24 16v26" />
              <path d="M14 42h20" />
              <path d="M6 32l10-4M42 32l-10-4" />
            </svg>
          )}
          {f.icon === 'kitchen' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 32a16 16 0 0 1 32 0" />
              <path d="M6 32h36" />
              <path d="M24 10v4" />
              <circle cx="24" cy="8" r="2" />
            </svg>
          )}
          {f.icon === 'people' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="17" cy="15" r="5" />
              <path d="M7 38v-3a8 8 0 0 1 8-8h4a8 8 0 0 1 8 8v3" />
              <circle cx="33" cy="17" r="4" opacity="0.7" />
              <path d="M27 38v-2a7 7 0 0 1 7-7h1a7 7 0 0 1 7 7v2" opacity="0.7" />
            </svg>
          )}
          {f.icon === 'fence' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 10v28M18 6v32M26 10v28M34 6v32M42 10v28" />
              <path d="M6 18h38M6 30h38" />
            </svg>
          )}
          {f.icon === 'tv' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="6" y="10" width="36" height="24" rx="2" />
              <path d="M18 40h12M24 34v6" />
            </svg>
          )}
          {f.icon === 'heating' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 8a4 4 0 0 1 8 0v18a8 8 0 1 1-8 0Z" />
              <path d="M26 16v10" />
            </svg>
          )}
          {f.icon === 'parking' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 28l3-10a3 3 0 0 1 3-2h20a3 3 0 0 1 3 2l3 10" />
              <rect x="6" y="28" width="36" height="10" rx="2" />
              <circle cx="14" cy="38" r="2" fill="currentColor" stroke="none" />
              <circle cx="34" cy="38" r="2" fill="currentColor" stroke="none" />
            </svg>
          )}
          {f.icon === 'pin' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M24 42s14-12.5 14-22a14 14 0 1 0-28 0c0 9.5 14 22 14 22Z" />
              <circle cx="24" cy="20" r="5" />
            </svg>
          )}
        </span>
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </div>
    ))
  }
</div>

<style>
  .facility-icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 1.5rem;
  }

  .facility-icons__item {
    text-align: center;
  }

  .facility-icons__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    color: var(--color-green-deep);
    margin-bottom: 0.9rem;
  }

  .facility-icons__icon svg {
    width: 100%;
    height: 100%;
  }

  .facility-icons__item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .facility-icons__item p {
    font-style: italic;
    color: #6b6659;
    font-size: 0.95rem;
    max-width: 26ch;
    margin: 0 auto;
  }

  @media (max-width: 780px) {
    .facility-icons {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.25rem 1rem;
    }
  }

  @media (max-width: 480px) {
    .facility-icons {
      grid-template-columns: 1fr;
    }
  }
</style>
