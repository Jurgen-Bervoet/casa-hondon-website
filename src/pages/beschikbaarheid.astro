---
import Layout from '../layouts/Layout.astro';
import AvailabilityCalendar from '../components/AvailabilityCalendar.astro';
import BookingForm from '../components/BookingForm.astro';
import PricingTable from '../components/PricingTable.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { fetchBusyRanges } from '../lib/calendar';
import { photo } from '../lib/images';
import { ROUTES } from '../i18n/routes';

const bookedRanges = await fetchBusyRanges();
---

<Layout
  lang="nl"
  active="availability"
  title="Prijzen & Beschikbaarheid — Villa Solmira"
  description="Bekijk de beschikbaarheid van Villa Solmira, de prijzen, betalingsvoorwaarden en annuleringsvoorwaarden."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Prijzen & Beschikbaarheid</span>
      <h1>Plan je verblijf</h1>
      <p>
        Bekijk in onze kalender wanneer het huis beschikbaar is en kies de periode die voor
        jullie past. Er is geen vaste aankomstdag.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Foto: zwembad en terras" image={photo('terras1-15.png')} />
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Prijzen</h2>
      <p class="section-intro">
        Onze prijzen zijn afhankelijk van het seizoen. Hieronder vind je een eerste richtprijs
        per seizoen — de definitieve tarieven volgen hier binnenkort.
      </p>
      <PricingTable
        headers={{ season: 'Seizoen', period: 'Periode', perWeek: 'Per week' }}
        rows={[
          {
            season: 'Laagseizoen',
            period: '15 september t/m 14 maart (buiten Kerst & Nieuwjaar)',
            perWeek: '€ 750',
          },
          {
            season: 'Middenseizoen',
            period: '15 maart t/m 14 juni, en Kerst & Nieuwjaar',
            perWeek: '€ 950',
          },
          {
            season: 'Hoogseizoen',
            period: '15 juni t/m 14 september',
            perWeek: '€ 1.450',
          },
        ]}
      />
      <p class="fine-print">
        Opmerking: dit zijn voorlopige richtprijzen op basis van vergelijkbare woningen in de
        omgeving. De definitieve tarieven worden hier aangevuld zodra ze vastliggen.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Beschikbaarheid</h2>
        <AvailabilityCalendar
          bookedRanges={bookedRanges}
          locale="nl-BE"
          weekdayLabels={['Ma', 'Di', 'Wo', 'Do', 'Vr', 'Za', 'Zo']}
          legendAvailable="Beschikbaar"
          legendBooked="Bezet"
          note="Zie je een datum die je wenst niet bezet staan? Stuur gerust je aanvraag door via het formulier."
        />
      </div>
      <div>
        <h2>Vraag je verblijf aan</h2>
        <BookingForm
          labels={{
            name: 'Naam',
            email: 'E-mailadres',
            phone: 'Telefoonnummer',
            arrival: 'Aankomstdatum',
            departure: 'Vertrekdatum',
            guests: 'Aantal gasten',
            message: 'Bericht (optioneel)',
            submit: 'Aanvraag versturen',
            success: 'Bedankt! Je aanvraag is verstuurd — we nemen snel contact met je op.',
            error: 'Er ging iets mis bij het versturen. Probeer het opnieuw of mail ons rechtstreeks.',
          }}
        />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Goed om te weten</h2>
      <ul class="practical">
        <li>Inchecken kan tussen 16:00 en 21:00 uur, uitchecken uiterlijk om 11:00 uur.</li>
        <li>Je reservatie is definitief na betaling van 50% van de huursom; het restbedrag en de waarborg (€ 800) betaal je één maand voor aankomst.</li>
        <li>Annuleren kan gratis tot 8 weken vooraf. Daarna gelden oplopende annuleringskosten.</li>
      </ul>
      <p class="fine-print">
        Dit zijn de belangrijkste punten in het kort. Alle details — waaronder huisregels,
        energiekosten en aansprakelijkheid — vind je in onze{' '}
        <a href={ROUTES.terms.nl}>algemene voorwaarden</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .section-intro {
    max-width: 68ch;
    margin-bottom: 2rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .practical {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 60ch;
  }

  .practical li {
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .fine-print {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #57534a;
  }

  .fine-print a {
    color: var(--color-clay-deep);
    font-weight: 600;
  }
</style>
