---
interface Feature {
  title: string;
  text: string;
  image: string;
  imageLabel: string;
}

interface Props {
  features: Feature[];
  prevLabel?: string;
  nextLabel?: string;
}

const { features, prevLabel = 'Vorige', nextLabel = 'Volgende' } = Astro.props;
---

<div class="feature-slider" data-feature-slider>
  <div class="feature-slider__track" data-track>
    {
      features.map((f) => (
        <article class="feature-slide">
          <img src={f.image} alt={f.imageLabel} class="feature-slide__img" />
          <div class="feature-slide__body">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        </article>
      ))
    }
  </div>
  <div class="feature-slider__controls">
    <button type="button" class="feature-slider__btn" data-prev aria-label={prevLabel}>
      ‹
    </button>
    <button type="button" class="feature-slider__btn" data-next aria-label={nextLabel}>
      ›
    </button>
  </div>
</div>

<style>
  .feature-slider {
    position: relative;
  }

  .feature-slider__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }

  .feature-slider__track::-webkit-scrollbar {
    display: none;
  }

  .feature-slide {
    flex: 0 0 min(560px, 86%);
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--color-line);
    overflow: hidden;
  }

  .feature-slide__img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .feature-slide__body {
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .feature-slide__body h3 {
    margin-bottom: 0.5rem;
  }

  .feature-slide__body p {
    margin: 0;
    font-size: 0.92rem;
    color: #57534a;
  }

  .feature-slider__controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .feature-slider__btn {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: #fff;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-green-deep);
  }

  .feature-slider__btn:hover {
    background: var(--color-cream-deep);
  }

  @media (max-width: 560px) {
    .feature-slide {
      flex-basis: 78vw;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-feature-slider]').forEach((slider) => {
    const track = slider.querySelector('[data-track]');
    const prevBtn = slider.querySelector('[data-prev]');
    const nextBtn = slider.querySelector('[data-next]');
    if (!track) return;

    const scrollByCard = (dir: number) => {
      const card = track.querySelector('.feature-slide');
      const amount = card ? card.getBoundingClientRect().width + 24 : 300;
      track.scrollBy({ left: dir * amount, behavior: 'smooth' });
    };

    prevBtn?.addEventListener('click', () => scrollByCard(-1));
    nextBtn?.addEventListener('click', () => scrollByCard(1));
  });
</script>
