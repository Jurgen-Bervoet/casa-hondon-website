---
import Layout from '../../layouts/Layout.astro';
import PhotoCollage from '../../components/PhotoCollage.astro';
import InfoList from '../../components/InfoList.astro';
import BedroomCards from '../../components/BedroomCards.astro';
import Gallery from '../../components/Gallery.astro';
import CTABlock from '../../components/CTABlock.astro';
import { ROUTES } from '../../i18n/routes';
---

<Layout
  lang="en"
  active="house"
  title="The House — Casa Lana"
  description="Discover Casa Lana: layout, bedrooms, bathrooms, kitchen and the private pool of this holiday home in Hondón de las Nieves."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">The House</span>
      <h1>Space, comfort and calm</h1>
      <p>
        Casa Lana is a spacious, fully single-level home for up to six people. The house
        stands on a fully fenced 10,000 m² plot and offers plenty of privacy and space.
        Inside you'll find three spacious bedrooms, two bathrooms, a living room, a fully
        equipped kitchen and a storage room. Central air conditioning and heating keep things
        comfortable all year round.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <PhotoCollage
        mainLabel="Photo: pool with mountain views"
        overlayLabel="Photo: terrace"
        mainRatio="21 / 9"
        overlayRatio="4 / 3"
        corner="bottom-right"
        mainImage="/zwembad%20en%20terras.jpg"
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Everything for a relaxed stay</h2>
      <InfoList
        columns={2}
        items={[
          'Sleeps 6',
          '3 spacious bedrooms',
          '2 bathrooms',
          '3 x 11 metre private pool',
          '10,000 m² own plot',
          'Fully fenced',
          'Central air conditioning and heating',
          'Pellet stove',
          'Wifi',
          'TV',
          'BBQ',
          'Private parking and garage',
          'Fully single-level',
          'Quiet location away from mass tourism',
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Sleeping</h2>
      <p class="section-intro">
        Casa Lana has three spacious bedrooms for two people each. Every bedroom has a
        160 cm-wide double bed. On arrival, the beds are already made up, so your holiday can
        start right away.
      </p>
      <BedroomCards
        items={[
          {
            name: 'Bedroom 1 — master',
            photoLabel: 'Photo: bedroom 1 (master)',
            bed: '160 cm-wide double bed',
            ensuiteLabel: 'Own en-suite bathroom',
          },
          {
            name: 'Bedroom 2',
            photoLabel: 'Photo: bedroom 2',
            bed: '160 cm-wide double bed',
          },
          {
            name: 'Bedroom 3',
            photoLabel: 'Photo: bedroom 3',
            bed: '160 cm-wide double bed',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap details">
      <div class="detail">
        <h2>Two bathrooms</h2>
        <p>
          The house has two fully fitted bathrooms. The master bedroom has its own en-suite
          bathroom. The second bathroom, with both a bath and a shower, is shared by bedrooms
          2 and 3.
        </p>
        <p>
          Per person we provide one large bath towel and one small towel. A hair dryer is
          also available. Both bathrooms have fly screens.
        </p>
      </div>

      <div class="detail">
        <h2>A kitchen you can really cook in</h2>
        <p>
          Fancy cooking an elaborate meal, quickly making something for the kids, or a
          leisurely coffee on the terrace in the morning? The kitchen is fully equipped for a
          comfortable stay.
        </p>
        <p>
          You'll find a fridge, small freezer, dishwasher, oven, microwave, air fryer, kettle,
          juicer and a Dolce Gusto Neo coffee machine. Plates, glasses, cups, cutlery,
          cookware and other kitchen essentials are all plentifully provided.
        </p>
      </div>

      <div class="detail">
        <h2>Comfort throughout the house</h2>
        <p>
          Casa Lana has central air conditioning and heating, complemented by a pellet stove.
          Wifi is available throughout the house, and there's a TV.
        </p>
        <p>
          A washing machine, vacuum cleaner and iron are also available. For families with a
          baby, we provide a cot and highchair on request. The entire house is single-level,
          with no stairs inside.
        </p>
      </div>

      <div class="detail">
        <h2>Outdoor living</h2>
        <p>
          When you come to Spain, you mostly want to live outdoors. That's why the outdoor
          space matters to us just as much as the house itself.
        </p>
        <p>
          Casa Lana sits on a 10,000 m² plot and has a large private pool of 3 by 11 metres.
          The pool is exclusively for your group and is maintained weekly, on Thursdays.
        </p>
        <p>
          There are six sun loungers around the pool. There is no natural shade at the pool or
          terrace — we provide parasols so you can create your own shady spot.
        </p>
        <p>
          There's a seating area for a relaxed drink and a large outdoor table with eight
          chairs for breakfast, lunch or a long dinner together. The BBQ is ready for evenings
          when you fancy eating in. Outdoor lighting is also available, so the terrace stays
          part of your evening after sunset.
        </p>
      </div>

      <div class="detail">
        <h2>All the space to yourselves</h2>
        <p>
          The entire plot is fenced. You park your car on the property itself, and there's
          also a spacious garage.
        </p>
        <p>
          Casa Lana stands freely and offers plenty of space around the house. At the same
          time, people live in the wider area with whom we have a good relationship. Peace
          and privacy, without feeling completely cut off from the world.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>To bring yourself</h2>
      <InfoList columns={1} items={['Beach towels', 'Optionally, pool toys']} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Gallery</h2>
      <Gallery
        labels={[
          'Pool',
          'Terrace',
          'Living room',
          'Kitchen',
          'Bedroom 1',
          'Bedroom 2',
          'Bedroom 3',
          'Bathroom',
          'Garden',
        ]}
      />
    </div>
  </section>

  <CTABlock
    title="Fancy staying here?"
    text="Check Casa Lana's availability and send your request."
    ctaLabel="Check availability"
    ctaHref={ROUTES.availability.en}
  />
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .section-intro {
    max-width: 68ch;
    margin-bottom: 2rem;
  }

  .details {
    display: grid;
    gap: 3rem;
    max-width: 74ch;
  }

  .detail h2 {
    margin-bottom: 0.6rem;
  }

  .detail p {
    color: #3a362c;
  }
</style>
