---
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';

interface StoryItem {
  heading?: string;
  paragraphs: string[];
  image?: ImageMetadata;
  imageLabel: string;
  listHeading?: string;
  list?: string[];
}

interface Props {
  items: StoryItem[];
}

const { items } = Astro.props;
---

<div class="story-blocks">
  {
    items.map((item, i) => (
      <article class:list={['story-block', { 'story-block--reverse': i % 2 === 1 }]}>
        <div class="story-block__photo">
          {item.image ? (
            <Image src={item.image} alt={item.imageLabel} class="story-block__img" width={900} />
          ) : (
            <PlaceholderImage label={item.imageLabel} fill class="story-block__img" />
          )}
        </div>
        <div class="story-block__text">
          {item.heading && <h2>{item.heading}</h2>}
          {item.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          {item.list && item.list.length > 0 && (
            <div class="story-block__list">
              {item.listHeading && <h3>{item.listHeading}</h3>}
              <ul>
                {item.list.map((li) => (
                  <li>
                    <span class="story-block__mark" aria-hidden="true">
                      ✓
                    </span>
                    {li}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </article>
    ))
  }
</div>

<style>
  .story-blocks {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .story-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .story-block--reverse .story-block__photo {
    order: 2;
  }

  .story-block--reverse .story-block__text {
    order: 1;
  }

  .story-block__photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .story-block__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-block__text h2 {
    margin-bottom: 0.8rem;
  }

  .story-block__text p {
    color: #3a362c;
    margin-bottom: 1rem;
  }

  .story-block__text p:last-child {
    margin-bottom: 0;
  }

  .story-block__list {
    margin-top: 1.5rem;
  }

  .story-block__list h3 {
    margin-bottom: 0.6rem;
  }

  .story-block__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .story-block__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.96rem;
    color: #3a362c;
  }

  .story-block__mark {
    color: var(--color-clay-deep);
    font-weight: 700;
    flex-shrink: 0;
  }

  @media (max-width: 780px) {
    .story-block {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .story-block--reverse .story-block__photo,
    .story-block--reverse .story-block__text {
      order: initial;
    }
  }
</style>
