---
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  mainLabel: string;
  overlayLabel: string;
  mainRatio?: string;
  overlayRatio?: string;
  corner?: 'bottom-left' | 'bottom-right' | 'top-left' | 'top-right';
  mainImage?: ImageMetadata;
  overlayImage?: ImageMetadata;
}

const {
  mainLabel,
  overlayLabel,
  mainRatio = '4 / 3',
  overlayRatio = '5 / 4',
  corner = 'bottom-left',
  mainImage,
  overlayImage,
} = Astro.props;

// Keep the main placeholder's caption clear of the overlay by anchoring it
// to the opposite corner instead of dead-centering it.
const oppositeCorner = {
  'bottom-left': 'top-right',
  'bottom-right': 'top-left',
  'top-left': 'bottom-right',
  'top-right': 'bottom-left',
} as const;

// Astro's <Image> needs explicit width+height to crop server-side to the
// intended ratio — relying on CSS aspect-ratio alone on the <img> itself
// doesn't reliably override a portrait source photo's intrinsic size.
function heightFor(width: number, ratio: string): number {
  const [w, h] = ratio.split('/').map((n) => parseFloat(n.trim()));
  return Math.round(width * (h / w));
}

const mainWidth = 900;
const overlayWidth = 600;
---

<div class:list={['collage', `collage--${corner}`]}>
  {
    mainImage ? (
      <Image
        src={mainImage}
        alt={mainLabel}
        class="collage__main"
        width={mainWidth}
        height={heightFor(mainWidth, mainRatio)}
      />
    ) : (
      <PlaceholderImage
        label={mainLabel}
        ratio={mainRatio}
        class="collage__main"
        labelPosition={oppositeCorner[corner]}
      />
    )
  }
  {
    overlayImage ? (
      <Image
        src={overlayImage}
        alt={overlayLabel}
        class="collage__overlay"
        width={overlayWidth}
        height={heightFor(overlayWidth, overlayRatio)}
      />
    ) : (
      <PlaceholderImage label={overlayLabel} ratio={overlayRatio} class="collage__overlay" />
    )
  }
</div>

<style>
  .collage {
    position: relative;
    padding-bottom: 3rem;
  }

  .collage :global(.collage__main) {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 0;
  }

  .collage :global(.collage__overlay) {
    position: absolute;
    width: 42%;
    min-width: 160px;
    height: auto;
    object-fit: cover;
    box-shadow: 0 18px 34px rgba(30, 27, 18, 0.22);
    border-radius: 0;
  }

  .collage--bottom-left :global(.collage__overlay) {
    left: -5%;
    bottom: 0;
  }

  .collage--bottom-right :global(.collage__overlay) {
    right: -5%;
    bottom: 0;
  }

  .collage--top-left :global(.collage__overlay) {
    left: -5%;
    top: -2rem;
  }

  .collage--top-right :global(.collage__overlay) {
    right: -5%;
    top: -2rem;
  }

  @media (max-width: 640px) {
    .collage :global(.collage__overlay) {
      width: 56%;
      left: auto;
      right: 4%;
    }
  }
</style>
