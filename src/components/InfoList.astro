---
interface Props {
  items: string[];
  columns?: number;
}

const { items, columns = 2 } = Astro.props;
---

<ul class="info-list" style={{ '--cols': columns }}>
  {
    items.map((item) => (
      <li>
        <span class="info-list__mark" aria-hidden="true">
          ✓
        </span>
        {item}
      </li>
    ))
  }
</ul>

<style>
  .info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 0.75rem 2rem;
  }

  .info-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.96rem;
  }

  .info-list__mark {
    color: var(--color-clay-deep);
    font-weight: 700;
    flex-shrink: 0;
  }

  @media (max-width: 620px) {
    .info-list {
      grid-template-columns: 1fr;
    }
  }
</style>
