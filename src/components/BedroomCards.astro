---
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';

interface Bedroom {
  name: string;
  photoLabel: string;
  image?: ImageMetadata;
  bed: string;
  badges?: string[];
}

interface Props {
  items: Bedroom[];
}

const { items } = Astro.props;
---

<div class="bedrooms">
  {
    items.map((b) => (
      <article class="bedroom">
        {b.image ? (
          <Image src={b.image} alt={b.photoLabel} class="bedroom__img" width={700} height={394} />
        ) : (
          <PlaceholderImage label={b.photoLabel} ratio="16 / 9" />
        )}
        <div class="bedroom__body">
          <h3>{b.name}</h3>
          <p>{b.bed}</p>
          {b.badges && b.badges.map((badge) => <p>{badge}</p>)}
        </div>
      </article>
    ))
  }
</div>

<style>
  .bedrooms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .bedroom {
    background: #fff;
  }

  .bedroom__img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .bedroom__body {
    padding: 1.5rem 1.25rem 1.75rem;
  }

  .bedroom__body h3 {
    margin-bottom: 0.5rem;
  }

  .bedroom__body p {
    margin: 0;
    font-size: 0.92rem;
    color: #57534a;
  }

  .bedroom__body p + p {
    margin-top: 0.3rem;
  }

  @media (max-width: 780px) {
    .bedrooms {
      grid-template-columns: 1fr;
    }
  }
</style>
