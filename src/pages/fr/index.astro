---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import PhotoCollage from '../../components/PhotoCollage.astro';
import CTABlock from '../../components/CTABlock.astro';
import { ROUTES } from '../../i18n/routes';
---

<Layout
  lang="fr"
  active="home"
  title="Casa Helena — Maison de vacances avec piscine à Hondón de las Nieves"
  description="Casa Helena est une petite maison de vacances avec piscine privée à Hondón de las Nieves, Alicante. Calme, nature et vie en plein air."
>
  <Hero
    title="Casa Helena"
    subtitle="Soleil, calme et votre propre piscine au cœur de Hondón de las Nieves"
    ctaLabel="Voir les disponibilités"
    ctaHref={ROUTES.availability.fr}
    imageLabel="Photo : piscine et terrasse de Casa Helena"
    image="/hero.jpg"
  />

  <section class="section section--white">
    <div class="wrap intro-collage">
      <div class="intro-collage__photos">
        <PhotoCollage
          mainLabel="Photo : piscine et terrasse"
          overlayLabel="Photo : intérieur / séjour"
          mainRatio="4 / 3"
          overlayRatio="5 / 4"
          corner="bottom-left"
          mainImage="/zwembad%20en%20terras.jpg"
          overlayImage="/woonruimte.jpg"
        />
      </div>
      <div class="intro-collage__text">
        <span class="eyebrow">Notre histoire</span>
        <p class="intro__text">
          Casa Helena est un rêve devenu réalité. Après des années à parcourir l'Espagne, nous
          savions une chose : nous voulions un jour notre propre endroit ici, quelque part entre
          Valence et Alicante. Après une longue recherche, exigeante, nous avons trouvé cette
          maison — spacieuse, avec une magnifique piscine, dans une région tranquille qui reste
          pourtant proche de tout.
        </p>
        <p class="intro__text">
          C'est avec beaucoup d'amour que nous avons choisi cet endroit, et c'est avec le même
          amour que nous le partageons avec des familles qui, comme nous, recherchent le calme :
          pas de tourisme de masse, pas de fêtes bruyantes, mais du silence, de l'espace et du
          temps les uns pour les autres.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <FeatureGrid
        features={[
          { title: 'Piscine & terrasse', text: 'Votre propre piscine, entretenue chaque semaine, sur un grand terrain entièrement clôturé.' },
          { title: 'Calme & nature', text: 'La maison est totalement isolée, dans une oasis de calme — seuls les grillons peuvent vous réveiller la nuit.' },
          { title: 'Hondón de las Nieves', text: 'À peine 10 minutes en voiture pour rejoindre le village, avec de bons restaurants et un café petit-déjeuner sympathique.' },
          { title: 'Confort & intimité', text: '3 chambres spacieuses, 2 salles de bain et un grand garage pour votre voiture.' },
        ]}
      />
    </div>
  </section>

  <CTABlock
    title="Planifiez votre séjour à Casa Helena"
    text="Consultez les disponibilités et envoyez votre demande — nous confirmons rapidement par e-mail."
    ctaLabel="Voir les disponibilités et réserver"
    ctaHref={ROUTES.availability.fr}
  />
</Layout>

<style>
  .intro-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .intro__text {
    font-size: 1.15rem;
    color: #4a4638;
  }

  @media (max-width: 780px) {
    .intro-collage {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-collage__photos {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
