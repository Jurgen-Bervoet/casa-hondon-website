---
interface Feature {
  title: string;
  text: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

<div class="feature-grid">
  {
    features.map((f) => (
      <div class="feature-card">
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </div>
    ))
  }
</div>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
  }

  .feature-card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
    padding: 1.6rem 1.4rem;
  }

  .feature-card h3 {
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    font-size: 0.92rem;
    margin: 0;
    color: #57534a;
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
