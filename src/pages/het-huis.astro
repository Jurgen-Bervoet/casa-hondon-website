---
import Layout from '../layouts/Layout.astro';
import PhotoBand from '../components/PhotoBand.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import FacilityIcons from '../components/FacilityIcons.astro';
import BedroomCards from '../components/BedroomCards.astro';
import BathroomFeature from '../components/BathroomFeature.astro';
import AlternatingStory from '../components/AlternatingStory.astro';
import CTABlock from '../components/CTABlock.astro';
import { photo } from '../lib/images';
import { ROUTES } from '../i18n/routes';
---

<Layout
  lang="nl"
  active="house"
  title="Het Huis — Casa Lana"
  description="Ontdek Casa Lana: indeling, voorzieningen, slaapkamers, keuken en het privézwembad van dit vakantiehuis in Hondón de las Nieves."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Het Huis</span>
      <h1>Ruimte, comfort en rust</h1>
      <p>
        Casa Lana is een ruime, volledig gelijkvloerse woning voor maximaal zes personen. Het
        huis staat op een volledig omheind terrein van 10.000 m² en biedt veel privacy en
        ruimte. Binnen vind je drie ruime slaapkamers, twee badkamers, een woonkamer, een
        volledig uitgeruste keuken en een berging. Centrale airconditioning en verwarming
        zorgen het hele jaar door voor een aangename temperatuur.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Foto: woonkamer" image={photo('woonkamer1-4.jpg')} />
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Alles voor een ontspannen verblijf</h2>
      <FacilityIcons
        items={[
          {
            icon: 'people',
            title: 'Capaciteit',
            text: 'Plaats voor maximaal 6 personen.',
          },
          {
            icon: 'bed',
            title: 'Slaapkamers',
            text: '3 ruime slaapkamers, elk met een tweepersoonsbed van 160 cm breed.',
          },
          {
            icon: 'bath',
            title: 'Badkamers',
            text: '2 volledig ingerichte badkamers, met haardroger.',
          },
          {
            icon: 'pool',
            title: 'Privézwembad',
            text: 'Zwembad van 3 x 12 meter, uitsluitend voor jullie gezelschap.',
          },
          {
            icon: 'fence',
            title: 'Eigen terrein',
            text: '10.000 m² volledig omheind terrein.',
          },
          {
            icon: 'terrace',
            title: 'Zonneterras',
            text: 'Zithoek, buitentafel en BBQ, met zicht op de bergen.',
          },
          {
            icon: 'kitchen',
            title: 'Goed uitgeruste keuken',
            text: 'Oven, vaatwasser, airfryer en Dolce Gusto Neo koffiemachine.',
          },
          {
            icon: 'wifi',
            title: 'Gratis wifi',
            text: 'Wifi is gratis beschikbaar in het hele huis.',
          },
          {
            icon: 'tv',
            title: 'TV',
            text: 'Televisie aanwezig in de woonkamer.',
          },
          {
            icon: 'heating',
            title: 'Verwarming & airco',
            text: 'Centrale airconditioning en verwarming, aangevuld met een pelletkachel.',
          },
          {
            icon: 'parking',
            title: 'Parking & garage',
            text: 'Privéparking op eigen terrein en een ruime garage.',
          },
          {
            icon: 'pin',
            title: 'Rustige ligging',
            text: 'Volledig gelijkvloers, weg van het massatoerisme.',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Slapen</h2>
      <p class="section-intro">
        Casa Lana beschikt over drie ruime slaapkamers voor telkens twee personen. Iedere
        slaapkamer heeft een tweepersoonsbed van 160 cm breed. Bij aankomst zijn de bedden
        voor jullie opgemaakt, je vakantie kan dus meteen beginnen.
      </p>
      <BedroomCards
        items={[
          {
            name: 'Slaapkamer 1 — master',
            photoLabel: 'Foto: slaapkamer 1 (master)',
            image: photo('master-bedroom2.jpg'),
            bed: 'Tweepersoonsbed van 160 cm breed',
            badges: ['Eigen badkamer (en-suite)', 'Zicht op en toegang tot het zwembad'],
          },
          {
            name: 'Slaapkamer 2',
            photoLabel: 'Foto: slaapkamer 2',
            image: photo('slaapkamer2-1.jpg'),
            bed: 'Tweepersoonsbed van 160 cm breed',
          },
          {
            name: 'Slaapkamer 3',
            photoLabel: 'Foto: slaapkamer 3',
            image: photo('slaapkamer3-1.jpg'),
            bed: 'Tweepersoonsbed van 160 cm breed',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <BathroomFeature
        title="Badkamers"
        leftImage={photo('badkamer1-1.jpg')}
        leftLabel="Foto: gedeelde badkamer (bad en douche)"
        rightImage={photo('badkamer2-2.jpg')}
        rightLabel="Foto: en-suite badkamer (master)"
        paragraphs={[
          'Het huis heeft twee volledig ingerichte badkamers. De master slaapkamer heeft een eigen en-suite badkamer. De tweede badkamer, met zowel bad als douche, wordt gedeeld door slaapkamer 2 en 3.',
          'Per persoon voorzien we één grote badhanddoek en één kleine handdoek. Ook een haardroger is aanwezig. In de badkamers zijn vliegramen voorzien.',
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <AlternatingStory
        items={[
          {
            heading: 'Een keuken waarin je echt kunt koken',
            imageLabel: 'Foto: keuken',
            image: photo('keuken1-2.jpg'),
            paragraphs: [
              `Zelf uitgebreid koken, snel iets klaarmaken voor de kinderen of 's morgens rustig koffie drinken op het terras? De keuken is volledig ingericht voor een comfortabel verblijf.`,
              `Je vindt er een koelkast, kleine diepvries, vaatwasser, oven, microgolfoven, airfryer, waterkoker, fruitpers en een Dolce Gusto Neo koffiemachine. Ook borden, glazen, tassen, bestek, kookgerei en andere keukenbenodigdheden zijn ruim voorzien.`,
            ],
          },
          {
            heading: 'Comfort in het hele huis',
            imageLabel: 'Foto: woonkamer',
            image: photo('woonkamer1-3.jpg'),
            paragraphs: [
              `Casa Lana beschikt over centrale airconditioning en verwarming, aangevuld met een pelletkachel. Wifi is aanwezig in het huis en er is een televisie.`,
              `Ook een wasmachine, stofzuiger en strijkijzer staan ter beschikking. Voor gezinnen met een baby voorzien we op aanvraag een kinderbedje en kinderstoel. Het volledige huis is gelijkvloers en er zijn binnen geen trappen.`,
            ],
          },
          {
            heading: 'Buiten leven',
            imageLabel: 'Foto: terras',
            image: photo('terras1-6b.jpg'),
            paragraphs: [
              `Als je naar Spanje komt, wil je vooral buiten leven. Daarom is de buitenruimte voor ons minstens even belangrijk als het huis zelf.`,
              `Casa Lana ligt op een terrein van 10.000 m² en beschikt over een groot privézwembad van 3 bij 12 meter. Het zwembad is uitsluitend voor jullie gezelschap en wordt wekelijks op donderdag onderhouden.`,
              `Rond het zwembad staan zes ligstoelen. Er zijn parasols voorzien zodat je zelf een schaduwrijke plek kunt creëren.`,
              `Er is een zithoek om rustig iets te drinken en een grote buitentafel met acht stoelen om samen te ontbijten, lunchen of 's avonds lang te tafelen. De BBQ staat klaar voor avonden waarop je gezellig thuis wilt eten.`,
            ],
          },
          {
            heading: 'Alle ruimte voor jezelf',
            imageLabel: 'Foto: terrein rond Casa Lana',
            image: photo('terrein1-1.jpg'),
            paragraphs: [
              `Het volledige terrein is omheind. Je wagen parkeer je op het eigen terrein en er is ook een ruime garage.`,
              `Casa Lana staat vrij en biedt veel ruimte rondom het huis. Tegelijk wonen er mensen in de ruimere omgeving met wie we zelf een goed contact hebben. Rust en privacy, zonder het gevoel volledig van de wereld afgesloten te zijn.`,
            ],
            listHeading: 'Zelf meenemen',
            list: ['Strandlakens', 'Eventueel zwembadspeelgoed'],
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight" id="fotogalerij">
    <div class="wrap">
      <h2>Fotogalerij</h2>
      <PhotoGrid
        closeLabel="Sluiten"
        prevLabel="Vorige"
        nextLabel="Volgende"
        items={[
          { label: 'Zwembad en terras', image: photo('zwembad en terras.jpg') },
          { label: 'Terras', image: photo('terras1-13.jpg') },
          { label: 'Buitentafel', image: photo('buitentafel1-5.jpg') },
          { label: 'Woonkamer', image: photo('woonkamer1-1.jpg') },
          { label: 'Keuken', image: photo('keuken1-1.jpg') },
          { label: 'Slaapkamer 1', image: photo('master-bedroom.jpg') },
          { label: 'Slaapkamer 2', image: photo('slaapkamer2-2.jpg') },
          { label: 'Slaapkamer 3', image: photo('slaapkamer3-2.jpg') },
          { label: 'Badkamer 1', image: photo('badkamer1-2.jpg') },
          { label: 'Badkamer 2', image: photo('badkamer2-1.jpg') },
          { label: 'Lounge', image: photo('lounge1-1.jpg') },
          { label: 'Casa Lana buiten', image: photo('hero.jpg') },
          { label: 'Avondsfeer', image: photo('IMG_6065.jpg') },
          { label: 'Omgeving', image: photo('IMG_6059.jpg') },
          { label: 'Zwembad bij avond', image: photo('IMG_6058.jpg') },
          { label: 'Terras bij zonsondergang', image: photo('terras1-6b.jpg') },
        ]}
      />
    </div>
  </section>

  <CTABlock
    title="Zin om hier te logeren?"
    text="Bekijk de beschikbaarheid van Casa Lana en stuur je aanvraag door."
    ctaLabel="Bekijk beschikbaarheid"
    ctaHref={ROUTES.availability.nl}
  />
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .section-intro {
    max-width: 68ch;
    margin-bottom: 2rem;
  }

</style>
