# Copy to .env for local development, and set the same variable in
# Netlify under Site configuration → Environment variables for production.

# Google Calendar "Secret address in iCal format" — found under your
# calendar's Settings → Integrate calendar. Mark bookings as all-day
# events on that calendar; the availability page fetches this feed at
# build time to show which dates are booked.
GOOGLE_CALENDAR_ICAL_URL=
