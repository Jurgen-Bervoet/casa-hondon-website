---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { photo } from '../../lib/images';
---

<Layout
  lang="fr"
  active="contact"
  title="Contact — Villa Solmira"
  description="Contactez-nous à propos de Villa Solmira, la maison de vacances à Hondón de las Nieves."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Contact</span>
      <h1>Envie de découvrir notre coin d'Espagne ?</h1>
      <p>
        Vous avez une question sur la maison, la région ou une période de séjour précise ?
        N'hésitez pas à nous contacter. Nous louons la maison directement et répondons à vos
        questions avec plaisir, personnellement.
      </p>
      <p>
        Pour une demande, nous avons seulement besoin de vos dates d'arrivée et de départ
        souhaitées, du nombre d'adultes et d'enfants, et de vos coordonnées.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Photo : vue aérienne de Villa Solmira" image={photo('drone7.png')} />
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Coordonnées</h2>
        <ul class="contact-details">
          <li><strong>E-mail</strong><span><a href="mailto:info@villa-solmira.eu">info@villa-solmira.eu</a></span></li>
          <li><strong>Localisation</strong><span>Hondón de las Nieves, Alicante, Espagne</span></li>
        </ul>
      </div>
      <div>
        <h2>Formulaire de contact</h2>
        <ContactForm
          labels={{
            name: 'Nom',
            email: 'Adresse e-mail',
            message: 'Message',
            submit: 'Envoyer',
            success: 'Merci ! Votre message a été envoyé — nous répondrons dès que possible.',
            error: "Une erreur s'est produite lors de l'envoi. Réessayez ou écrivez-nous directement.",
          }}
        />
      </div>
    </div>
    <div class="wrap map-wrap">
      <MapEmbed
        lat={38.312833}
        lon={-0.899722}
        label="Carte : localisation de Villa Solmira"
        consentText="Vous n'avez pas accepté les cookies marketing, nous n'affichons donc pas Google Maps ici. Ajustez vos préférences pour voir la carte."
        consentButtonLabel="Ajuster les préférences de cookies"
      />
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .contact-details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .contact-details li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .contact-details li strong {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-clay-deep);
  }

  .contact-details a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .contact-details a:hover {
    color: var(--color-green-deep);
    text-decoration: underline;
  }

  .map-wrap {
    margin-top: 2.5rem;
  }
</style>
