---
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import { ROUTES, LANGS, type Lang, type PageGroup } from '../i18n/routes';
import { photo } from '../lib/images';
import '../styles/global.css';

interface Props {
  lang: Lang;
  active: PageGroup;
  title: string;
  description: string;
}

const { lang, active, title, description } = Astro.props;

const altUrls = Object.fromEntries(LANGS.map((l) => [l, ROUTES[active][l]])) as Record<Lang, string>;
const otherLangs = LANGS.filter((l) => l !== 'nl');

const site = Astro.site ?? new URL('https://villa-solmira.eu');
const canonicalURL = new URL(ROUTES[active][lang], site);
const ogImage = await getImage({ src: photo('hero.jpg'), width: 1200 });
const imageURL = new URL(ogImage.src, site);

const OG_LOCALES: Record<Lang, string> = {
  nl: 'nl_BE',
  es: 'es_ES',
  en: 'en_US',
  fr: 'fr_FR',
};

const LAT = 38.312833;
const LON = -0.899722;

const droneImage = await getImage({ src: photo('drone7.png'), width: 1200 });
const poolImage = await getImage({ src: photo('zwembad en terras.jpg'), width: 1200 });

const SD_TEXT: Record<Lang, { description: string; amenities: string[] }> = {
  nl: {
    description:
      'Vakantiehuis met privézwembad (3 x 12 m) in Hondón de las Nieves, Alicante — 6 personen, 3 slaapkamers, 2 badkamers, 10.000 m² volledig omheind terrein.',
    amenities: ['Privézwembad', 'Wifi', 'Airconditioning', 'Pelletkachel', 'Garage', 'Volledig uitgeruste keuken', 'Terras'],
  },
  es: {
    description:
      'Casa de vacaciones con piscina privada (3 x 12 m) en Hondón de las Nieves, Alicante — 6 personas, 3 dormitorios, 2 baños, parcela de 10.000 m² completamente vallada.',
    amenities: ['Piscina privada', 'Wifi', 'Aire acondicionado', 'Estufa de pellets', 'Garaje', 'Cocina totalmente equipada', 'Terraza'],
  },
  en: {
    description:
      'Holiday home with a private pool (3 x 12 m) in Hondón de las Nieves, Alicante — 6 guests, 3 bedrooms, 2 bathrooms, fully fenced 10,000 m² plot.',
    amenities: ['Private pool', 'Wifi', 'Air conditioning', 'Pellet stove', 'Garage', 'Fully equipped kitchen', 'Terrace'],
  },
  fr: {
    description:
      'Maison de vacances avec piscine privée (3 x 12 m) à Hondón de las Nieves, Alicante — 6 personnes, 3 chambres, 2 salles de bain, terrain entièrement clôturé de 10 000 m².',
    amenities: ['Piscine privée', 'Wifi', 'Climatisation', 'Poêle à pellets', 'Garage', 'Cuisine entièrement équipée', 'Terrasse'],
  },
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': `${site}#business`,
  name: 'Villa Solmira',
  description: SD_TEXT[lang].description,
  url: new URL(ROUTES.home[lang], site).toString(),
  image: [imageURL, new URL(droneImage.src, site), new URL(poolImage.src, site)].map(String),
  email: 'info@villa-solmira.eu',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Solana 15',
    postalCode: '03688',
    addressLocality: 'Hondón de las Nieves',
    addressRegion: 'Alicante',
    addressCountry: 'ES',
  },
  geo: { '@type': 'GeoCoordinates', latitude: LAT, longitude: LON },
  hasMap: `https://www.google.com/maps?q=${LAT},${LON}`,
  sameAs: ['https://www.google.com/search?kgmid=/g/11p22hcldz'],
  checkinTime: '16:00',
  checkoutTime: '11:00',
  numberOfRooms: 3,
  priceRange: '€750 – €1.450 / week',
  availableLanguage: ['nl', 'es', 'en', 'fr'],
  amenityFeature: SD_TEXT[lang].amenities.map((name) => ({
    '@type': 'LocationFeatureSpecification',
    name,
    value: true,
  })),
  containsPlace: {
    '@type': 'House',
    name: 'Villa Solmira',
    numberOfBedrooms: 3,
    numberOfBathroomsTotal: 2,
    occupancy: { '@type': 'QuantitativeValue', maxValue: 6, unitText: 'persons' },
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {
      LANGS.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(ROUTES[active][l], site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(ROUTES[active].nl, site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Villa Solmira" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {
      LANGS.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    {
      lang === 'nl' && (
        <script is:inline define:vars={{ altUrls, otherLangs }}>
          (function () {
            try {
              if (document.cookie.indexOf('lang-chosen=1') !== -1) return;
              var prefs = navigator.languages || [navigator.language || ''];
              var match = null;
              for (var i = 0; i < prefs.length; i++) {
                var code = (prefs[i] || '').slice(0, 2).toLowerCase();
                if (otherLangs.indexOf(code) !== -1) {
                  match = code;
                  break;
                }
              }
              document.cookie = 'lang-chosen=1;path=/;max-age=31536000';
              if (match && altUrls[match]) {
                window.location.replace(altUrls[match]);
              }
            } catch (e) {}
          })();
        </script>
      )
    }
  </head>
  <body>
    <Header lang={lang} active={active} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
    <Analytics />
  </body>
</html>
