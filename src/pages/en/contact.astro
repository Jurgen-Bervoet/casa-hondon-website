---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  lang="en"
  active="contact"
  title="Contact — Casa Helena"
  description="Get in touch about Casa Helena, the holiday home in Hondón de las Nieves."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Contact</span>
      <h1>Questions about Casa Helena?</h1>
      <p>
        Have a question about Casa Helena that isn't related to a booking request?
        Feel free to get in touch.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Details</h2>
        <ul class="contact-details">
          <li><strong>Email</strong><span>info@casahelena.example</span></li>
          <li><strong>Phone</strong><span>+34 XXX XXX XXX</span></li>
          <li><strong>Location</strong><span>Hondón de las Nieves, Alicante, Spain</span></li>
        </ul>
      </div>
      <div>
        <h2>Contact form</h2>
        <ContactForm
          labels={{
            name: 'Name',
            email: 'Email address',
            message: 'Message',
            submit: 'Send',
          }}
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .contact-details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .contact-details li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .contact-details li strong {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-clay-deep);
  }
</style>
