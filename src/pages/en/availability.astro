---
import Layout from '../../layouts/Layout.astro';
import AvailabilityCalendar from '../../components/AvailabilityCalendar.astro';
import BookingForm from '../../components/BookingForm.astro';
---

<Layout
  lang="en"
  active="availability"
  title="Availability & Booking — Casa Helena"
  description="Check the availability of Casa Helena and send a booking request."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Availability & Booking</span>
      <h1>Plan your stay</h1>
      <p>
        Check Casa Helena's availability below and send a request for your preferred
        dates. We'll confirm your request by email as soon as possible.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Availability</h2>
        <AvailabilityCalendar
          monthLabel="Example month (demo)"
          weekdayLabels={['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su']}
          legendAvailable="Available"
          legendBooked="Booked"
          note="This is example data. Real availability will be added here soon."
        />
      </div>
      <div>
        <h2>Request form</h2>
        <BookingForm
          labels={{
            name: 'Name',
            email: 'Email address',
            phone: 'Phone number',
            arrival: 'Arrival date',
            departure: 'Departure date',
            guests: 'Number of guests',
            message: 'Message (optional)',
            submit: 'Send request',
          }}
        />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Practical info</h2>
      <ul class="practical">
        <li><strong>Check-in</strong> — between 13:00 and 20:00</li>
        <li><strong>Check-out</strong> — before 11:00</li>
        <li><strong>Minimum stay</strong> — to be confirmed</li>
        <li><strong>Pets</strong> — to be confirmed</li>
        <li><strong>Smoking</strong> — not allowed indoors</li>
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Pricing & deposit</h2>
        <ul class="practical">
          <li>Your booking is confirmed after an initial deposit of 25% of the total rental sum.</li>
          <li>The remaining balance is due 6 weeks before arrival.</li>
          <li>A security deposit of €1,000 is due no later than 1 week before your stay begins.</li>
          <li>Energy costs are included up to a standard usage (indicatively €8/day electricity, €5/day water); usage above this is deducted from the security deposit.</li>
          <li>Cleaning fee: €160, mandatory per booking.</li>
        </ul>
      </div>
      <div>
        <h2>Cancellation policy</h2>
        <ul class="practical">
          <li>Cancelling 6 weeks or more before arrival: 25% of the rental price</li>
          <li>Cancelling 4 weeks or more before arrival: 50% of the rental price</li>
          <li>Cancelling 2 weeks or more before arrival: 100% of the rental price</li>
        </ul>
        <p class="fine-print">The owner is not responsible for accidents or theft.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .practical {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 60ch;
  }

  .practical li {
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .fine-print {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #57534a;
  }
</style>
