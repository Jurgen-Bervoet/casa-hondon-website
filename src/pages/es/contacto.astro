---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { photo } from '../../lib/images';
---

<Layout
  lang="es"
  active="contact"
  title="Contacto — Villa Solmira"
  description="Ponte en contacto sobre Villa Solmira, la casa de vacaciones en Hondón de las Nieves."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Contacto</span>
      <h1>¿Te apetece descubrir nuestro rincón de España?</h1>
      <p>
        ¿Tienes alguna pregunta sobre la casa, la zona o un periodo de estancia concreto? No
        dudes en contactarnos. Alquilamos la casa directamente y respondemos tus preguntas con
        gusto y de forma personal.
      </p>
      <p>
        Para una solicitud solo necesitamos vuestra fecha de llegada y salida deseada, el
        número de adultos y niños, y vuestros datos de contacto.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Foto: vista aérea de Villa Solmira" image={photo('drone7.png')} />
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Datos</h2>
        <ul class="contact-details">
          <li><strong>Correo</strong><span><a href="mailto:info@villa-solmira.eu">info@villa-solmira.eu</a></span></li>
          <li><strong>Ubicación</strong><span>Hondón de las Nieves, Alicante, España</span></li>
        </ul>
      </div>
      <div>
        <h2>Formulario de contacto</h2>
        <ContactForm
          labels={{
            name: 'Nombre',
            email: 'Correo electrónico',
            message: 'Mensaje',
            submit: 'Enviar',
            success: 'Gracias! Tu mensaje ha sido enviado — responderemos lo antes posible.',
            error: 'Algo salió mal al enviar. Inténtalo de nuevo o escríbenos directamente.',
          }}
        />
      </div>
    </div>
    <div class="wrap map-wrap">
      <MapEmbed
        lat={38.312833}
        lon={-0.899722}
        label="Mapa: ubicación de Villa Solmira"
        consentText="No has aceptado las cookies de marketing, así que no mostramos Google Maps aquí. Ajusta tus preferencias para ver el mapa."
        consentButtonLabel="Ajustar preferencias de cookies"
      />
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .contact-details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .contact-details li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .contact-details li strong {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-clay-deep);
  }

  .contact-details a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .contact-details a:hover {
    color: var(--color-green-deep);
    text-decoration: underline;
  }

  .map-wrap {
    margin-top: 2.5rem;
  }
</style>
