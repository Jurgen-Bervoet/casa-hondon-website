---
import Layout from '../../layouts/Layout.astro';
import AvailabilityCalendar from '../../components/AvailabilityCalendar.astro';
import BookingForm from '../../components/BookingForm.astro';
import PricingTable from '../../components/PricingTable.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import { fetchBusyRanges } from '../../lib/calendar';
import { photo } from '../../lib/images';
import { ROUTES } from '../../i18n/routes';

const bookedRanges = await fetchBusyRanges();
---

<Layout
  lang="en"
  active="availability"
  title="Pricing & Availability — Villa Solmira"
  description="Check the availability of Villa Solmira, pricing, payment terms and cancellation policy."
>
  <section class="section">
    <div class="wrap page-intro">
      <span class="eyebrow">Pricing & Availability</span>
      <h1>Plan your stay</h1>
      <p>
        Check our calendar to see when the house is available and choose the period that
        suits you. There is no fixed arrival day.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <PhotoBand label="Photo: pool and terrace" image={photo('terras1-15.png')} />
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Pricing</h2>
      <p class="section-intro">
        Our prices depend on the season. Below is a first indicative price per season — the
        final rates will be added here soon.
      </p>
      <PricingTable
        headers={{ season: 'Season', period: 'Period', perWeek: 'Per week' }}
        rows={[
          {
            season: 'Low season',
            period: '15 September to 14 March (excluding Christmas & New Year)',
            perWeek: '€750',
          },
          {
            season: 'Mid season',
            period: '15 March to 14 June, and Christmas & New Year',
            perWeek: '€950',
          },
          {
            season: 'High season',
            period: '15 June to 14 September',
            perWeek: '€1,450',
          },
        ]}
      />
      <p class="fine-print">
        Note: these are provisional indicative prices based on comparable properties in the
        area. Final rates will be added here once confirmed.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div>
        <h2>Availability</h2>
        <AvailabilityCalendar
          bookedRanges={bookedRanges}
          locale="en-GB"
          weekdayLabels={['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su']}
          legendAvailable="Available"
          legendBooked="Booked"
          note="Don't see your preferred dates marked as booked? Send your request via the form anyway."
        />
      </div>
      <div>
        <h2>Request your stay</h2>
        <BookingForm
          labels={{
            name: 'Name',
            email: 'Email address',
            phone: 'Phone number',
            arrival: 'Arrival date',
            departure: 'Departure date',
            guests: 'Number of guests',
            message: 'Message (optional)',
            submit: 'Send request',
            success: "Thank you! Your request has been sent — we'll get back to you soon.",
            error: 'Something went wrong while sending. Please try again or email us directly.',
          }}
        />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Good to know</h2>
      <ul class="practical">
        <li>Check-in is between 16:00 and 21:00; check-out is by 11:00 at the latest.</li>
        <li>Your booking is confirmed after payment of 50% of the rental sum; the remaining amount and the security deposit (€800) are due one month before arrival.</li>
        <li>You can cancel for free up to 8 weeks in advance. After that, cancellation fees apply on a sliding scale.</li>
      </ul>
      <p class="fine-print">
        These are the key points in brief. For all details — including house rules, energy
        costs and liability — see our <a href={ROUTES.terms.en}>terms and conditions</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    max-width: 68ch;
  }

  .section-intro {
    max-width: 68ch;
    margin-bottom: 2rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .practical {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 60ch;
  }

  .practical li {
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
  }

  .fine-print {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #57534a;
  }

  .fine-print a {
    color: var(--color-clay-deep);
    font-weight: 600;
  }
</style>
