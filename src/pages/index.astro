---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import CTABlock from '../components/CTABlock.astro';
import { ROUTES } from '../i18n/routes';
---

<Layout
  lang="nl"
  active="home"
  title="Casa Helena — Vakantiehuis met zwembad in Hondón de las Nieves"
  description="Casa Helena is een klein vakantiehuis met eigen zwembad in Hondón de las Nieves, Alicante. Rust, natuur en buitenleven."
>
  <Hero
    title="Casa Helena"
    subtitle="Rust, zon en een eigen zwembad in het hart van Hondón de las Nieves"
    ctaLabel="Bekijk beschikbaarheid"
    ctaHref={ROUTES.availability.nl}
    imageLabel="Foto: zwembad en terras van Casa Helena"
    image="/hero.jpg"
  />

  <section class="section section--white">
    <div class="wrap intro-collage">
      <div class="intro-collage__photos">
        <PhotoCollage
          mainLabel="Foto: zwembad en terras"
          overlayLabel="Foto: interieur / woonruimte"
          mainRatio="4 / 3"
          overlayRatio="5 / 4"
          corner="bottom-left"
          mainImage="/zwembad%20en%20terras.jpg"
          overlayImage="/woonruimte.jpg"
        />
      </div>
      <div class="intro-collage__text">
        <span class="eyebrow">Ons verhaal</span>
        <p class="intro__text">
          Casa Helena is een droom die werkelijkheid werd. Na jaren reizen door Spanje wisten we
          één ding zeker: ooit wilden we hier een eigen plek, ergens tussen Valencia en Alicante.
          Na een lange, kieskeurige zoektocht vonden we dit huis — ruim, met een prachtig
          zwembad, in een rustige streek die toch nooit ver van alles ligt.
        </p>
        <p class="intro__text">
          Met veel liefde kozen we voor deze plek, en met evenveel liefde delen we ze met
          gezinnen die, net als wij, op zoek zijn naar rust: geen massatoerisme, geen wilde
          feestjes, maar stilte, ruimte en tijd voor elkaar.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <FeatureGrid
        features={[
          { title: 'Zwembad & terras', text: 'Je eigen zwembad, wekelijks onderhouden, op een groot en volledig omheind terrein.' },
          { title: 'Rust & natuur', text: "Het huis staat helemaal alleen, in een oase van rust — enkel de krekels maken je 's nachts wakker." },
          { title: 'Hondón de las Nieves', text: 'Op amper 10 minuten rijden vind je het dorp, met goede restaurants en een gezellig ontbijtcafé.' },
          { title: 'Comfort & privacy', text: '3 ruime slaapkamers, 2 badkamers en een grote garage waar je wagen binnen kan.' },
        ]}
      />
    </div>
  </section>

  <CTABlock
    title="Plan je verblijf in Casa Helena"
    text="Bekijk de beschikbaarheid en stuur een aanvraag — we bevestigen snel per e-mail."
    ctaLabel="Naar beschikbaarheid & boeken"
    ctaHref={ROUTES.availability.nl}
  />
</Layout>

<style>
  .intro-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .intro__text {
    font-size: 1.15rem;
    color: #4a4638;
  }

  @media (max-width: 780px) {
    .intro-collage {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-collage__photos {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
