---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<div class="faq-list">
  {
    items.map((item) => (
      <div class="faq-item">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))
  }
</div>

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

<style>
  .faq-list {
    display: grid;
    gap: 1.75rem;
  }

  .faq-item h3 {
    margin-bottom: 0.4rem;
  }

  .faq-item p {
    margin: 0;
    color: #4a4638;
  }
</style>
