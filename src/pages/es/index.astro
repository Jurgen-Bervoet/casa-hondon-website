---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import FeatureSlider from '../../components/FeatureSlider.astro';
import PhotoCollage from '../../components/PhotoCollage.astro';
import PhotoMosaic from '../../components/PhotoMosaic.astro';
import CTABlock from '../../components/CTABlock.astro';
import { ROUTES } from '../../i18n/routes';
---

<Layout
  lang="es"
  active="home"
  title="Casa Lana — Casa de vacaciones con piscina privada en Hondón de las Nieves"
  description="Casa Lana es nuestra casa de vacaciones en Hondón de las Nieves: calma, espacio y una piscina privada en el interior de la Costa Blanca, capacidad para 6 personas."
>
  <Hero
    title="Casa Lana"
    subtitle="Una casa preciosa rodeada de montañas españolas, calma y espacio"
    ctaLabel="Consultar disponibilidad"
    ctaHref={ROUTES.availability.es}
    imageLabel="Foto: piscina y terraza de Casa Lana"
    image="/hero.jpg"
  />

  <section class="section section--white">
    <div class="wrap intro-collage decor-host">
      <img src="/palmbladeren-watercolor.webp" alt="" class="decor-img" />
      <div class="intro-collage__photos">
        <PhotoMosaic
          topLeftLabel="Foto: piscina y terraza"
          topLeftImage="/zwembad%20en%20terras.jpg"
          bottomLeftLabel="Foto: cocina"
          bottomLeftImage="/keuken1-1.jpg"
          rightLabel="Foto: baño"
          rightImage="/badkamer2-1.jpg"
        />
      </div>
      <div class="intro-collage__text">
        <span class="eyebrow">Bienvenidos a nuestro rincón de España</span>
        <h2>Casa para 6 personas</h2>
        <p class="intro__text">
          Lejos del ajetreo, por un tiempo. Tiempo el uno para el otro, para largas mañanas
          junto a la piscina, comidas tranquilas en la terraza y disfrutar del silencio a tu
          alrededor. Casa Lana es nuestra casa de vacaciones en Hondón de las Nieves, en el
          tranquilo interior de la Costa Blanca.
        </p>
        <p class="intro__specs">
          3 dormitorios, 2 baños · parcela de 10.000 m² · piscina privada de 3 x 11 m
        </p>
        <p class="intro__text">
          Aquí te alojas lejos del turismo de masas y, al mismo tiempo, tienes sorprendentemente
          cerca de todo. El centro de Hondón de las Nieves está a unos 8 minutos en coche, el
          aeropuerto de Alicante a unos 30 minutos, y Alicante y el Mediterráneo a unos 40
          minutos.
        </p>
        <p class="intro__text">
          ¿Te quedas hoy junto a la piscina? ¿Te vas de tapas a Alicante? ¿Visitas Elche, un
          mercado local o uno de los pueblos de los alrededores? Nada es obligatorio. Todo es
          posible.
        </p>
        <p class="intro__text intro__text--last">
          Este es el lugar que nosotros mismos buscábamos en España. Y lo compartimos con
          mucho gusto con vosotros. <a href={ROUTES.story.es}>Lee nuestra historia →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Todo para una estancia relajada</h2>
      <FeatureSlider
        prevLabel="Anterior"
        nextLabel="Siguiente"
        features={[
          {
            title: 'Piscina y terraza',
            text: 'Piscina privada de 3 x 11 metros, mantenida cada semana, en una parcela de 10.000 m².',
            image: '/zwembad%20en%20terras.jpg',
            imageLabel: 'Foto: piscina y terraza',
          },
          {
            title: 'Calma y naturaleza',
            text: 'La casa está totalmente aislada, en un oasis de calma — solo los grillos podrían despertarte por la noche.',
            image: '/IMG_6059.jpg',
            imageLabel: 'Foto: paisaje alrededor de Hondón de las Nieves',
          },
          {
            title: 'Hondón de las Nieves',
            text: 'A unos 8 minutos en coche encontrarás el pueblo, con buenos restaurantes y una acogedora cafetería para desayunar.',
            image: '/IMG_6065.jpg',
            imageLabel: 'Foto: ambiente nocturno en Casa Lana',
          },
          {
            title: 'Comodidad y privacidad',
            text: '6 personas, 3 dormitorios amplios, 2 baños y un gran garaje donde cabe tu coche.',
            image: '/woonkamer1-1.jpg',
            imageLabel: 'Foto: salón',
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap escape-section">
      <div class="escape-section__photos">
        <PhotoCollage
          mainLabel="Foto: paisaje alrededor de Hondón de las Nieves"
          overlayLabel="Foto: piscina y terraza"
          mainRatio="4 / 5"
          overlayRatio="1 / 1"
          corner="bottom-right"
          mainImage="/IMG_6059.jpg"
          overlayImage="/zwembad%20en%20terras.jpg"
        />
      </div>
      <div class="escape-section__text">
        <span class="eyebrow">La zona</span>
        <h2>Lejos de todo. Y a la vez, nunca lejos.</h2>
        <p>
          Casa Lana está en pleno interior español, rodeada de montañas y naturaleza. Aquí te
          despiertas con silencio a tu alrededor y por la noche solo oyes los grillos.
        </p>
        <p>
          ¿Te apetece algo más de vida? Hondón de las Nieves, Aspe, Novelda y Elche están
          cerca. Para un día de ciudad, cultura, tapas o playa, conduces hacia Alicante. Santa
          Pola, Tabarca, Murcia, Villajoyosa y Altea también son bonitos destinos para una
          excursión de un día. Así combinas la calma del interior con todo lo que la Costa
          Blanca tiene para ofrecer.
        </p>
        <a href={ROUTES.area.es} class="btn btn--clay">Descubre la zona</a>
      </div>
    </div>
  </section>

  <CTABlock
    title="Planifica tu estancia en Casa Lana"
    text="Consulta la disponibilidad y envía tu solicitud — confirmamos rápido por correo."
    ctaLabel="Consultar disponibilidad"
    ctaHref={ROUTES.availability.es}
  />
</Layout>

<style>
  .intro-collage {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .intro__text {
    font-size: 1.05rem;
    color: #4a4638;
  }

  .intro__specs {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-green-deep);
    margin-bottom: 1.4rem;
  }

  .intro__text--last a {
    color: var(--color-clay-deep);
    font-weight: 600;
  }

  .escape-section {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .escape-section__text p {
    color: #4a4638;
    font-size: 1.05rem;
  }

  .escape-section__text .btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 780px) {
    .intro-collage {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-collage__photos {
      max-width: 420px;
      margin: 0 auto;
    }

    .escape-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .escape-section__photos {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
