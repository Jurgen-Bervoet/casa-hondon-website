---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import PhotoCollage from '../../components/PhotoCollage.astro';
import CTABlock from '../../components/CTABlock.astro';
import { ROUTES } from '../../i18n/routes';
---

<Layout
  lang="en"
  active="home"
  title="Casa Lana — Holiday home with private pool in Hondón de las Nieves"
  description="Casa Lana is our holiday home in Hondón de las Nieves: peace, space and a private pool inland from the Costa Blanca, sleeps 6."
>
  <Hero
    title="Casa Lana"
    subtitle="A beautiful house surrounded by Spanish mountains, peace and space"
    ctaLabel="Check availability"
    ctaHref={ROUTES.availability.en}
    imageLabel="Photo: pool and terrace at Casa Lana"
    image="/hero.jpg"
  />

  <section class="section section--white">
    <div class="wrap intro-collage">
      <div class="intro-collage__photos">
        <PhotoCollage
          mainLabel="Photo: pool and terrace"
          overlayLabel="Photo: interior / living space"
          mainRatio="4 / 3"
          overlayRatio="5 / 4"
          corner="bottom-left"
          mainImage="/zwembad%20en%20terras.jpg"
          overlayImage="/woonruimte.jpg"
        />
      </div>
      <div class="intro-collage__text">
        <span class="eyebrow">Welcome to our little corner of Spain</span>
        <p class="intro__text">
          Away from it all, for a while. Time for each other, for long mornings by the pool,
          leisurely meals on the terrace and enjoying the quiet around you.
        </p>
        <p class="intro__text">
          Casa Lana is our holiday home in Hondón de las Nieves, in the quiet inland of the
          Costa Blanca. The house sleeps up to six people and has three spacious bedrooms, two
          bathrooms, a fully fenced 10,000 m² plot and a private pool of 3 by 11 metres.
        </p>
        <p class="intro__text">
          Here you stay away from mass tourism while surprisingly much is still within reach.
          The centre of Hondón de las Nieves is about an 8-minute drive away, Alicante Airport
          about 30 minutes, and Alicante and the Mediterranean about 40 minutes.
        </p>
        <p class="intro__text">
          Staying by the pool all day today? Heading out for tapas in Alicante? Visiting
          Elche, a local market or one of the small villages nearby? Nothing has to happen.
          Anything can.
        </p>
        <p class="intro__text intro__text--last">
          This is the place we ourselves were looking for in Spain. And we're happy to share
          it with you. <a href={ROUTES.story.en}>Read our story →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Everything for a relaxed stay</h2>
      <FeatureGrid
        features={[
          { title: 'Pool & terrace', text: 'A 3 x 11 metre private pool, maintained weekly, on a 10,000 m² plot.' },
          { title: 'Peace & nature', text: 'The house stands completely on its own, in an oasis of calm — only the crickets might wake you at night.' },
          { title: 'Hondón de las Nieves', text: 'About an 8-minute drive to the village, with good restaurants and a cosy breakfast café.' },
          { title: 'Comfort & privacy', text: 'Sleeps 6, with 3 spacious bedrooms, 2 bathrooms and a large garage that fits your car.' },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap wide-section">
      <h2>Away from it all. Yet never far from anything.</h2>
      <p>
        Casa Lana sits right in the Spanish inland, surrounded by mountains and nature. Here
        you wake up to quiet around you, and at night you'll mostly hear the crickets.
      </p>
      <p>
        Fancy a bit more life? Hondón de las Nieves, Aspe, Novelda and Elche are all nearby.
        For a day of city life, culture, tapas or the beach, you head towards Alicante. Santa
        Pola, Tabarca, Murcia, Villajoyosa and Altea are also lovely day-trip destinations.
      </p>
      <p>That way you combine the calm of the inland with everything the Costa Blanca has to offer.</p>
      <a href={ROUTES.area.en} class="btn btn--outline-dark">Explore the area</a>
    </div>
  </section>

  <CTABlock
    title="Plan your stay at Casa Lana"
    text="Check availability and send a request — we confirm quickly by email."
    ctaLabel="Check availability"
    ctaHref={ROUTES.availability.en}
  />
</Layout>

<style>
  .intro-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .intro__text {
    font-size: 1.05rem;
    color: #4a4638;
  }

  .intro__text--last a {
    color: var(--color-clay-deep);
    font-weight: 600;
  }

  .wide-section {
    max-width: 68ch;
  }

  @media (max-width: 780px) {
    .intro-collage {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-collage__photos {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
