---
import { nextMonths, type DateRange } from '../lib/calendar';

interface Props {
  bookedRanges: DateRange[];
  monthsToShow?: number;
  locale: string;
  weekdayLabels: string[];
  legendAvailable: string;
  legendBooked: string;
  note: string;
}

const {
  bookedRanges,
  monthsToShow = 3,
  locale,
  weekdayLabels,
  legendAvailable,
  legendBooked,
  note,
} = Astro.props;

const grids = nextMonths(monthsToShow, bookedRanges);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<div class="calendar">
  <div class="calendar__legend">
    <span class="calendar__legend-item"><i class="dot dot--free"></i>{legendAvailable}</span>
    <span class="calendar__legend-item"><i class="dot dot--booked"></i>{legendBooked}</span>
  </div>

  <div class="calendar__months">
    {
      grids.map((grid) => (
        <div class="calendar__month-block">
          <p class="calendar__month">
            {monthFormatter.format(new Date(Date.UTC(grid.year, grid.month, 1)))}
          </p>

          <div class="calendar__grid calendar__grid--labels">
            {weekdayLabels.map((d) => (
              <span>{d}</span>
            ))}
          </div>

          <div class="calendar__grid">
            {Array.from({ length: grid.leadingEmpty }).map(() => (
              <span class="calendar__cell calendar__cell--empty" />
            ))}
            {grid.cells.map((cell) => (
              <span class:list={['calendar__cell', { 'is-booked': cell.booked }]}>{cell.day}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <p class="calendar__note">{note}</p>
</div>

<style>
  .calendar {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0;
    padding: 1.75rem;
  }

  .calendar__legend {
    display: flex;
    gap: 1.1rem;
    font-size: 0.82rem;
    color: #57534a;
    margin-bottom: 1.4rem;
  }

  .calendar__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot--free {
    background: var(--color-sage);
  }

  .dot--booked {
    background: var(--color-clay);
  }

  .calendar__months {
    display: grid;
    gap: 2rem;
  }

  .calendar__month {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-green-deep);
    margin: 0 0 0.8rem;
    text-transform: capitalize;
  }

  .calendar__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.4rem;
  }

  .calendar__grid--labels {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #8a8577;
    text-align: center;
  }

  .calendar__cell {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    background: var(--color-cream-deep);
    font-size: 0.85rem;
    color: var(--color-ink);
  }

  .calendar__cell--empty {
    background: transparent;
  }

  .calendar__cell.is-booked {
    background: var(--color-clay);
    color: #fff;
  }

  .calendar__note {
    margin: 1.5rem 0 0;
    font-size: 0.8rem;
    color: #8a8577;
  }
</style>
